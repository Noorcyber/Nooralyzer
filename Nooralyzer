# ================================================================
# DNS LATENCY
#
# Uses the shell's time facility around nslookup when available.
# If timing cannot be parsed reliably, the test remains N/A rather
# than reporting a fabricated latency.
# ================================================================

get_dns_latency_ms() {

    if ! have nslookup; then
        return 1
    fi

    DNS_TIME_FILE="${TMP_BASE}_dns_time"
    DNS_QUERY_COUNT=10
    DNS_SUCCESS=0

    START_MS="$(awk '{printf "%.0f",$1*1000}' /proc/uptime 2>/dev/null)"
    [ -n "$START_MS" ] || return 1

    i=1
    while [ "$i" -le "$DNS_QUERY_COUNT" ]; do
        if nslookup cloudflare.com >/dev/null 2>&1; then
            DNS_SUCCESS=$((DNS_SUCCESS + 1))
        fi
        i=$((i + 1))
    done

    END_MS="$(awk '{printf "%.0f",$1*1000}' /proc/uptime 2>/dev/null)"
    [ -n "$END_MS" ] || return 1

    ELAPSED=$((END_MS - START_MS))

    if [ "$DNS_SUCCESS" -eq 0 ] 2>/dev/null; then
        return 1
    fi

    # /proc/uptime has centisecond precision on Linux. A very fast
    # lookup batch can therefore measure as 0ms. Keep the result
    # honest rather than inventing sub-centisecond precision.
    if [ "$ELAPSED" -lt 1 ]; then
        ELAPSED=1
    fi

    AVG_MS=$((ELAPSED / DNS_QUERY_COUNT))
    [ "$AVG_MS" -gt 0 ] || AVG_MS=1

    printf '%s|%s|%s\n' "$DNS_QUERY_COUNT" "$DNS_SUCCESS" "$AVG_MS"
    return 0
}

report_dns_latency() {

    section "DNS LATENCY"

    if ! have nslookup; then
        skip "nslookup is not installed"
        return
    fi

    RESULT="$(get_dns_latency_ms)"

    if [ -z "$RESULT" ]; then
        skip "DNS latency could not be measured"
        return
    fi

    QUERIES="${RESULT%%|*}"
    REST="${RESULT#*|}"
    SUCCESS="${REST%%|*}"
    LATENCY="${REST#*|}"

    printf '  %-25s %s\n' "Resolver" "$(awk '/^[[:space:]]*nameserver[[:space:]]+/ {print $2; exit}' /etc/resolv.conf 2>/dev/null)"
    printf '  %-25s %s\n' "Queries" "$QUERIES"
    printf '  %-25s %s/%s\n' "Successful" "$SUCCESS" "$QUERIES"
    printf '  %-25s %s ms\n' "Average lookup time" "$LATENCY"

    if [ "$LATENCY" -ge 500 ] 2>/dev/null; then
        warn "DNS lookup latency is HIGH (${LATENCY} ms average)"
    elif [ "$LATENCY" -ge 150 ] 2>/dev/null; then
        warn "DNS lookup latency is elevated (${LATENCY} ms average)"
    elif [ "$SUCCESS" -lt "$QUERIES" ] 2>/dev/null; then
        warn "Some DNS queries failed (${SUCCESS}/${QUERIES} successful)"
    else
        ok "DNS lookup latency is within expected range"
    fi
}

# ================================================================
# INTERNET QUALITY
# ================================================================

report_internet_quality() {

    section "INTERNET QUALITY"

    if ! have ping; then
        skip "ping not installed"
        return
    fi

    printf '  %-14s %-10s %-10s %s\n' \
        "TARGET" "LOSS" "LATENCY" "STATUS"
    printf '  %-14s %-10s %-10s %s\n' \
        "--------------" "----------" "----------" "----------"

    for TARGET in 1.1.1.1 8.8.8.8; do

        RESULT="$(ping_test "$TARGET" 3)"

        if [ $? -eq 0 ]; then
            LOSS="${RESULT%%|*}"
            LATENCY="${RESULT#*|}"

            if [ "$LOSS" = "0" ] || [ "$LOSS" = "0.0" ]; then
                STATUS="OK"
                COLOR="$C_GREEN"
            elif [ "$LOSS" = "N/A" ]; then
                STATUS="UNKNOWN"
                COLOR="$C_DIM"
            else
                STATUS="WARN"
                COLOR="$C_YELLOW"
            fi
        else
            LOSS="N/A"
            LATENCY="N/A"
            STATUS="FAILED"
            COLOR="$C_YELLOW"
        fi

        printf '  %-14s %-10s %-10s ' \
            "$TARGET" "${LOSS}%" "${LATENCY} ms"
        printf '%s%s%s\n' "$COLOR" "$STATUS" "$C_RESET"
    done
}

# ================================================================
# MTU / PATH HEALTH
#
# Only runs if BusyBox ping exposes the DF/MTU option (-M).
# ================================================================

report_mtu() {

    section "PATH PACKET SIZE"

    GATEWAY="$(get_default_gateway)"

    if [ -z "$GATEWAY" ] && have ip; then
        GATEWAY="$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="via") {print $(i+1); exit}}')"
    fi

    if [ -z "$GATEWAY" ]; then
        skip "No reachable path gateway exposed"
        return
    fi

    if ! have ping; then
        skip "ping not installed"
        return
    fi

    if ! ping -c 1 -W 2 "$GATEWAY" >/dev/null 2>&1; then
        skip "Gateway is not ICMP reachable; packet-size test skipped"
        return
    fi

    PATH_DEV=""
    PATH_SRC=""

    if have ip; then
        ROUTE_INFO="$(ip route get 1.1.1.1 2>/dev/null)"
        PATH_DEV="$(printf '%s\n' "$ROUTE_INFO" | awk '{for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}')"
        PATH_SRC="$(printf '%s\n' "$ROUTE_INFO" | awk '{for(i=1;i<=NF;i++) if($i=="src") {print $(i+1); exit}}')"
    fi

    printf '  %-25s %s\n' "Gateway" "$GATEWAY"
    [ -n "$PATH_DEV" ] && printf '  %-25s %s\n' "Interface" "$PATH_DEV"
    [ -n "$PATH_SRC" ] && printf '  %-25s %s\n' "Source IP" "$PATH_SRC"

    printf '  %-12s %-12s %s\n' "PAYLOAD" "PACKET" "STATUS"
    printf '  %-12s %-12s %s\n' "------------" "------------" "----------"

    # BusyBox ping on the target AP does not support -M do, so this is
    # intentionally a packet-size reachability test rather than a DF/MTU
    # discovery claim. IPv4/ICMP overhead is 28 bytes.
    for SIZE in 1400 1450 1472; do
        TOTAL_SIZE=$((SIZE + 28))

        if ping -c 1 -W 2 -s "$SIZE" "$GATEWAY" >/dev/null 2>&1; then
            printf '  %-12s %-12s %sOK%s\n' \
                "$SIZE" "$TOTAL_SIZE" "$C_GREEN" "$C_RESET"
        else
            printf '  %-12s %-12s %sWARN%s\n' \
                "$SIZE" "$TOTAL_SIZE" "$C_YELLOW" "$C_RESET"
        fi
    done

    info "Packet-size testing does not prove end-to-end path MTU because this platform's ping does not support DF (-M do)."
}


# ================================================================
# WI-FI CLIENT QUALITY
#
# Correlates the existing SSID/interface information with client
# station statistics. RSSI is the primary signal indicator.
# Retry counts are supporting information and are not treated as
# a normalized retry percentage.
# ================================================================

get_client_quality() {

    IF="$1"

    iw "$IF" station dump 2>/dev/null |
        awk '
            function emit() {
                if (MAC == "")
                    return

                RSSI_NUM="N/A"
                if (SIGNAL ~ /^-?[0-9]+/) {
                    RSSI_NUM=SIGNAL
                    gsub(/[^-0-9].*/,"",RSSI_NUM)
                }

                if (RSSI_NUM != "N/A" && RSSI_NUM < -70)
                    WEAK=1
                else
                    WEAK=0

                if (RSSI_NUM != "N/A" && RSSI_NUM < -80)
                    HEALTH="HIGH"
                else if (RSSI_NUM != "N/A" && RSSI_NUM < -70)
                    HEALTH="WARN"
                else
                    HEALTH="OK"

                print MAC "|" RSSI_NUM "|" TX "|" RETRIES "|" HEALTH
            }

            /^Station / {
                emit()
                MAC=$2
                SIGNAL="N/A"
                TX="N/A"
                RETRIES="N/A"
                next
            }

            /^[[:space:]]*signal:/ {
                SIGNAL=$2
                next
            }

            /^[[:space:]]*tx bitrate:/ {
                TX=$3" "$4
                next
            }

            /^[[:space:]]*tx retries:/ {
                RETRIES=$3
                next
            }

            END {
                emit()
            }
        '
}

report_client_quality() {

    section_wide "WI-FI CLIENT QUALITY"

    printf '  %-7s %-9s %-8s %-12s %-12s %-10s %s\n' \
        "SSID" "IF" "CLIENTS" "AVG RSSI" "WEAK" "RETRIES" "HEALTH"

    printf '  %-7s %-9s %-8s %-12s %-12s %-10s %s\n' \
        "-------" "---------" "--------" "------------" "------------" "----------" "----------"

    QUALITY_FILE="${TMP_BASE}_quality"
    get_ap_interfaces > "$QUALITY_FILE" 2>/dev/null

    if [ ! -s "$QUALITY_FILE" ]; then
        skip "No AP-mode wireless interfaces detected"
        return
    fi

    while IFS="$(printf '\t')" read -r PHY INT; do

        [ -n "$INT" ] || continue

        ESSID="$(get_essid "$INT")"
        COUNT="$(count_clients "$INT")"
        [ -n "$COUNT" ] || COUNT=0

        if [ "$COUNT" -eq 0 ] 2>/dev/null; then
            printf '  %-7s %-9s %-8s %-12s %-12s %-10s %s\n' \
                "$ESSID" "$INT" "0" "N/A" "0" "0" "OK"
            continue
        fi

        DATA="$(get_client_quality "$INT")"

        SUM=0
        SIGNAL_COUNT=0
        WEAK=0
        HIGH_RETRY=0
        RETRY_SUM=0

        OLDIFS="$IFS"
        IFS=''
        while read -r LINE; do
            [ -n "$LINE" ] || continue

            OLDIFS2="$IFS"
            IFS='|'
            set -- $LINE
            IFS="$OLDIFS2"

            RSSI="$2"
            RETRIES="$4"
            HEALTH="$5"

            if [ "$RSSI" != "N/A" ] && [ -n "$RSSI" ]; then
                SUM=$((SUM + RSSI))
                SIGNAL_COUNT=$((SIGNAL_COUNT + 1))

                if [ "$RSSI" -lt -70 ] 2>/dev/null; then
                    WEAK=$((WEAK + 1))
                fi
            fi

            if [ "$RETRIES" -ge 20 ] 2>/dev/null; then
                HIGH_RETRY=$((HIGH_RETRY + 1))
            fi

            if [ "$RETRIES" != "N/A" ] && [ -n "$RETRIES" ]; then
                RETRY_SUM=$((RETRY_SUM + RETRIES))
            fi
        done <<EOF
$DATA
EOF
        IFS="$OLDIFS"

        if [ "$SIGNAL_COUNT" -gt 0 ]; then
            AVG="$(awk -v s="$SUM" -v c="$SIGNAL_COUNT" 'BEGIN {printf "%.0f",s/c}')"
        else
            AVG="N/A"
        fi

        HEALTH="OK"
        COLOR="$C_GREEN"

        if [ "$WEAK" -gt 0 ] || [ "$HIGH_RETRY" -gt 0 ]; then
            HEALTH="WARN"
            COLOR="$C_YELLOW"
        fi

        if [ "$AVG" != "N/A" ] && [ "$AVG" -lt -75 ] 2>/dev/null; then
            HEALTH="HIGH"
            COLOR="$C_RED"
        fi

        printf '  %-7s %-9s %-8s %-12s %-12s %-10s ' \
            "$ESSID" "$INT" "$COUNT" "$AVG dBm" "$WEAK" "$RETRY_SUM"
        printf '%s%s%s\n' "$COLOR" "$HEALTH" "$C_RESET"

    done < "$QUALITY_FILE"
}

# ================================================================
# PER-CLIENT HEALTH
# ================================================================

report_per_client_health() {

    section_wide "PER-CLIENT HEALTH"

    printf '  %-9s %-17s %-8s %-16s %-10s %s\n' \
        "IF" "CLIENT MAC" "RSSI" "TX RATE" "RETRIES" "HEALTH"

    printf '  %-9s %-17s %-8s %-16s %-10s %s\n' \
        "---------" "-----------------" "--------" "----------------" "----------" "----------"

    CLIENT_HEALTH_FILE="${TMP_BASE}_client_health"
    get_ap_interfaces > "$CLIENT_HEALTH_FILE" 2>/dev/null

    if [ ! -s "$CLIENT_HEALTH_FILE" ]; then
        skip "No AP-mode wireless interfaces detected"
        return
    fi

    while IFS="$(printf '\t')" read -r PHY INT; do

        DATA="$(
            iw "$INT" station dump 2>/dev/null |
            awk '
                function emit() {
                    if (MAC != "")
                        print MAC "|" SIGNAL "|" TX "|" RETRIES
                }

                /^Station / {
                    emit()
                    MAC=$2
                    SIGNAL="N/A"
                    TX="N/A"
                    RETRIES="N/A"
                    next
                }

                /^[[:space:]]*signal:/ { SIGNAL=$2; next }
                /^[[:space:]]*tx bitrate:/ { TX=$3" "$4; next }
                /^[[:space:]]*tx retries:/ { RETRIES=$3; next }

                END { emit() }
            '
        )"

        while IFS='|' read -r MAC RSSI TX RETRIES; do

            [ -n "$MAC" ] || continue

            HEALTH="OK"
            COLOR="$C_GREEN"

            RSSI_NUM="$(printf '%s\n' "$RSSI" | sed 's/[^-0-9].*//')"

            if [ -n "$RSSI_NUM" ] && [ "$RSSI_NUM" -lt -80 ] 2>/dev/null; then
                HEALTH="HIGH"
                COLOR="$C_RED"
            elif [ -n "$RSSI_NUM" ] && [ "$RSSI_NUM" -lt -70 ] 2>/dev/null; then
                HEALTH="WARN"
                COLOR="$C_YELLOW"
            fi

            if [ "$RETRIES" -ge 20 ] 2>/dev/null && [ "$HEALTH" = "OK" ]; then
                HEALTH="WARN"
                COLOR="$C_YELLOW"
            fi

            printf '  %-9s %-17s %-8s %-16s %-10s ' \
                "$INT" "$MAC" "$RSSI" "$TX" "$RETRIES"
            printf '%s%s%s\n' "$COLOR" "$HEALTH" "$C_RESET"

        done <<EOF
$DATA
EOF

    done < "$CLIENT_HEALTH_FILE"
}

# ================================================================
# TIME / NTP HEALTH
#
# Reports configuration and service evidence only. It does not
# change system time or force synchronization.
# ================================================================

report_time_ntp() {

    section "TIME / NTP HEALTH"

    printf '  %-25s %s\n' "System UTC time" "$(date -u '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null)"

    NTP_CONFIG=""

    if [ -r /etc/config/system ]; then
        NTP_CONFIG="$(grep -E '^[[:space:]]*list[[:space:]]+server' /etc/config/system 2>/dev/null)"
    fi

    if [ -z "$NTP_CONFIG" ] && [ -r /etc/ntp.conf ]; then
        NTP_CONFIG="$(grep -E '^[[:space:]]*server[[:space:]]+' /etc/ntp.conf 2>/dev/null)"
    fi

    if [ -n "$NTP_CONFIG" ]; then
        ok "NTP server configuration present"
    else
        info "NTP server configuration not exposed"
    fi

    if process_running ntpd; then
        ok "ntpd is running"
    elif process_running chronyd; then
        ok "chronyd is running"
    elif process_running systemd-timesyncd; then
        ok "systemd-timesyncd is running"
    else
        info "NTP synchronization process not detected"
    fi
}

# ================================================================
# HARDWARE TELEMETRY
#
# Uses hwmon data exposed by the AP. INA219 units follow the Linux
# hwmon ABI: voltage is mV, current mA, power uW, shunt mV.
# Radio temperatures are reported by the ath10k/ath11k hwmon drivers.
# ================================================================

report_hardware_telemetry() {

    section "HARDWARE TELEMETRY"

    FOUND=0

    # INA219 power monitor(s)
    for H in /sys/class/hwmon/hwmon*; do
        [ -d "$H" ] || continue
        NAME="$(cat "$H/name" 2>/dev/null)"

        case "$NAME" in
            ina219|ina220|ina226|ina228)
                FOUND=1

                BUS_MV="$(cat "$H/in1_input" 2>/dev/null)"
                CURRENT_MA="$(cat "$H/curr1_input" 2>/dev/null)"
                POWER_UW="$(cat "$H/power1_input" 2>/dev/null)"
                SHUNT_MV="$(cat "$H/in0_input" 2>/dev/null)"

                if [ -n "$BUS_MV" ]; then
                    BUS_V="$(awk -v v="$BUS_MV" 'BEGIN {printf "%.3f",v/1000}')"
                    printf '  %-25s %s V\n' "Bus voltage" "$BUS_V"
                else
                    printf '  %-25s N/A\n' "Bus voltage"
                fi

                if [ -n "$CURRENT_MA" ]; then
                    CURRENT_A="$(awk -v v="$CURRENT_MA" 'BEGIN {printf "%.3f",v/1000}')"
                    printf '  %-25s %s A\n' "Current" "$CURRENT_A"
                else
                    printf '  %-25s N/A\n' "Current"
                fi

                if [ -n "$POWER_UW" ]; then
                    POWER_W="$(awk -v v="$POWER_UW" 'BEGIN {printf "%.3f",v/1000000}')"
                    printf '  %-25s %s W\n' "Power" "$POWER_W"
                else
                    printf '  %-25s N/A\n' "Power"
                fi

                if [ -n "$SHUNT_MV" ]; then
                    printf '  %-25s %s mV\n' "Shunt voltage" "$SHUNT_MV"
                fi

                printf '  %-25s %s\n' "Power monitor" "$NAME"
                ;;
        esac
    done

    # Radio temperature telemetry
    for H in /sys/class/hwmon/hwmon*; do
        [ -d "$H" ] || continue
        NAME="$(cat "$H/name" 2>/dev/null)"

        case "$NAME" in
            ath10k_hwmon|ath11k_hwmon)
                FOUND=1
                TEMP_RAW="$(cat "$H/temp1_input" 2>/dev/null)"

                case "$TEMP_RAW" in
                    ''|*[!0-9]*)
                        continue
                        ;;
                esac

                TEMP_C="$(awk -v v="$TEMP_RAW" 'BEGIN {printf "%.0f",v/1000}')"
                STATUS="OK"
                COLOR="$C_GREEN"

                if [ "$TEMP_C" -ge 85 ] 2>/dev/null; then
                    STATUS="HIGH"
                    COLOR="$C_RED"
                elif [ "$TEMP_C" -ge 75 ] 2>/dev/null; then
                    STATUS="WARN"
                    COLOR="$C_YELLOW"
                fi

                printf '  %-25s %s%s C%s\n' \
                    "$NAME temperature" "$COLOR" "$TEMP_C" "$C_RESET"
                printf '  %-25s %s%s%s\n' \
                    "Temperature status" "$COLOR" "$STATUS" "$C_RESET"
                ;;
        esac
    done

    if [ "$FOUND" -eq 0 ]; then
        skip "Hardware telemetry not exposed by this platform"
    else
        info "Power telemetry is reported from hwmon and is not labeled as PoE negotiation unless explicit PoE/PSE telemetry is exposed."
    fi
}

# ================================================================
# REBOOT / CRASH EVIDENCE
# ================================================================

report_reboot_crash() {

    section "REBOOT / CRASH EVIDENCE"

    WATCHDOG="$(count_log 'watchdog|watchdog.*reset')"
    PANIC="$(count_log 'kernel panic|panic:|Oops:|call trace')"
    REBOOT="$(count_log 'reboot|system reboot|Restarting system')"
    OOM="$(count_log 'out of memory|oom-killer|killed process')"

    printf '  %-25s %-8s %s\n' "TEST" "COUNT" "STATUS"
    printf '  %-25s %-8s %s\n' "-------------------------" "--------" "----------"

    if [ "$WATCHDOG" -gt 0 ] 2>/dev/null; then
        printf '  %-25s %-8s %s%s%s\n' "Watchdog/reset events" "$WATCHDOG" "$C_YELLOW" "WARN" "$C_RESET"
    else
        printf '  %-25s %-8s %sOK%s\n' "Watchdog/reset events" "0" "$C_GREEN" "$C_RESET"
    fi

    if [ "$PANIC" -gt 0 ] 2>/dev/null; then
        printf '  %-25s %-8s %s%s%s\n' "Kernel panic evidence" "$PANIC" "$C_RED" "FAIL" "$C_RESET"
        issue "$PANIC kernel panic/Oops event(s) found"
    else
        printf '  %-25s %-8s %sOK%s\n' "Kernel panic evidence" "0" "$C_GREEN" "$C_RESET"
    fi

    printf '  %-25s %-8s %s\n' "Reboot-related events" "$REBOOT" "INFO"

    if [ "$OOM" -gt 0 ] 2>/dev/null; then
        printf '  %-25s %-8s %s%s%s\n' "OOM evidence" "$OOM" "$C_RED" "FAIL" "$C_RESET"
    else
        printf '  %-25s %-8s %sOK%s\n' "OOM evidence" "0" "$C_GREEN" "$C_RESET"
    fi

    info "Crash/reboot counts are log evidence and do not establish the reboot cause by themselves."
}

# ================================================================
# PROCESS RESOURCE HEALTH
#
# Only displays CPU/MEM columns when the platform's ps exposes
# those fields. Otherwise it safely reports capability unavailable.
# ================================================================

get_proc_cpu_mem() {

    PID="$1"

    [ -r "/proc/$PID/stat" ] || return 1
    [ -r "/proc/$PID/status" ] || return 1

    STAT1="$(cat "/proc/$PID/stat" 2>/dev/null)"
    UPTIME1="$(awk '{print $1}' /proc/uptime 2>/dev/null)"

    [ -n "$STAT1" ] || return 1
    [ -n "$UPTIME1" ] || return 1

    CLK_TCK=100
    if getconf >/dev/null 2>&1; then
        VALUE="$(getconf CLK_TCK 2>/dev/null)"
        case "$VALUE" in
            ''|*[!0-9]*) ;;
            *) CLK_TCK="$VALUE" ;;
        esac
    fi

    # Parse /proc/<pid>/stat safely around the command name parentheses.
    CPU1="$(printf '%s\n' "$STAT1" | awk -v c="$CLK_TCK" 'BEGIN{FS=" ";} {print ($14+$15)/c}')"

    sleep 1

    STAT2="$(cat "/proc/$PID/stat" 2>/dev/null)"
    UPTIME2="$(awk '{print $1}' /proc/uptime 2>/dev/null)"

    [ -n "$STAT2" ] || return 1
    [ -n "$UPTIME2" ] || return 1

    CPU2="$(printf '%s\n' "$STAT2" | awk -v c="$CLK_TCK" 'BEGIN{FS=" ";} {print ($14+$15)/c}')"

    CPU_PCT="$(awk -v c1="$CPU1" -v c2="$CPU2" -v t1="$UPTIME1" -v t2="$UPTIME2" \
        'BEGIN {dt=t2-t1; dc=c2-c1; if(dt>0) printf "%.1f", (dc/dt)*100; else print "0.0"}')"

    RSS_KB="$(awk '/^VmRSS:/ {print $2; exit}' "/proc/$PID/status" 2>/dev/null)"
    THREADS="$(awk '/^Threads:/ {print $2; exit}' "/proc/$PID/status" 2>/dev/null)"

    [ -n "$CPU_PCT" ] || CPU_PCT="N/A"
    [ -n "$RSS_KB" ] || RSS_KB="N/A"
    [ -n "$THREADS" ] || THREADS="N/A"

    RSS_MB="N/A"
    case "$RSS_KB" in
        ''|*[!0-9]*) ;;
        *) RSS_MB="$(awk -v k="$RSS_KB" 'BEGIN {printf "%.1f",k/1024}')" ;;
    esac

    printf '%s|%s|%s\n' "$CPU_PCT" "$RSS_MB" "$THREADS"
    return 0
}

get_pid_by_name() {

    PROC="$1"

    if have pgrep; then
        pgrep -f "$PROC" 2>/dev/null | head -n 1
        return
    fi

    ps w 2>/dev/null |
        grep -v grep |
        grep "$PROC" |
        awk 'NR==1 {print $1; exit}'
}

report_process_resources() {

    section_wide "PROCESS RESOURCE HEALTH"

    printf '  %-24s %-9s %-12s %-9s %s\n' \
        "PROCESS" "CPU" "RSS" "THREADS" "STATUS"

    printf '  %-24s %-9s %-12s %-9s %s\n' \
        "------------------------" "---------" "------------" "---------" "----------"

    FOUND=0

    for P in hostapd dnsmasq dashboard_controller connkeeper udshape udsplash anyip juggler; do

        PID="$(get_pid_by_name "$P")"
        [ -n "$PID" ] || continue

        FOUND=1

        DATA="$(get_proc_cpu_mem "$PID")"

        if [ -z "$DATA" ]; then
            printf '  %-24s %-9s %-12s %-9s %s%s%s\n' \
                "$P" "N/A" "N/A" "N/A" "$C_DIM" "UNAVAILABLE" "$C_RESET"
            continue
        fi

        CPU="${DATA%%|*}"
        REST="${DATA#*|}"
        RSS="${REST%%|*}"
        THREADS="${REST#*|}"

        STATUS="OK"
        COLOR="$C_GREEN"

        if [ "$CPU" != "N/A" ] && awk -v c="$CPU" 'BEGIN{exit !(c>=50)}'; then
            STATUS="HIGH"
            COLOR="$C_RED"
        elif [ "$CPU" != "N/A" ] && awk -v c="$CPU" 'BEGIN{exit !(c>=20)}'; then
            STATUS="WARN"
            COLOR="$C_YELLOW"
        fi

        if [ "$RSS" != "N/A" ] && awk -v m="$RSS" 'BEGIN{exit !(m>=128)}'; then
            if [ "$STATUS" = "OK" ]; then
                STATUS="WARN"
                COLOR="$C_YELLOW"
            fi
        fi

        printf '  %-24s %-9s %-12s %-9s ' \
            "$P" "${CPU}%" "${RSS} MB" "$THREADS"
        printf '%s%s%s\n' "$COLOR" "$STATUS" "$C_RESET"

    done

    [ "$FOUND" -eq 1 ] ||
        skip "No monitored processes found or /proc process data unavailable"
}

