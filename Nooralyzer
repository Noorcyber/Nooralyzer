    printf '  %-8s %-12s %-8s %-9s %-8s %-8s %-10s %s\n' \
        "--------" "------------" "--------" "---------" \
        "--------" "--------" "----------" "----------"

    SEEN=""

    while IFS="$(printf '\t')" read -r PHY INT; do

        [ -n "$PHY" ] || continue
        [ -n "$INT" ] || continue

        case " $SEEN " in
            *" $PHY "*)
                continue
                ;;
        esac

        SEEN="$SEEN $PHY"

        CHANNEL="$(get_channel "$INT")"
        WIDTH="$(get_width "$INT")"
        BUSY="$(get_busy "$INT" "$PHY")"
        NOISE="$(get_noise "$INT")"
        TXPOWER="$(get_txpower "$INT")"

        [ -n "$CHANNEL" ] || CHANNEL="N/A"
        [ -n "$WIDTH" ] || WIDTH="N/A"
        [ -n "$BUSY" ] || BUSY="N/A"
        [ -n "$NOISE" ] || NOISE="N/A"
        [ -n "$TXPOWER" ] || TXPOWER="N/A"

        HEALTH="OK"

        if [ "$BUSY" = "N/A" ]; then

            HEALTH="N/A"
            HEALTH_COLOR="$C_DIM"

        elif [ "$BUSY" -ge 70 ] 2>/dev/null; then

            HEALTH="HIGH"
            HEALTH_COLOR="$C_RED"

            issue "$INT reports ${BUSY}% channel busy time"

        elif [ "$BUSY" -ge 40 ] 2>/dev/null; then

            HEALTH="ELEVATED"
            HEALTH_COLOR="$C_YELLOW"

            warn "$INT reports ${BUSY}% channel busy time"

        else

            HEALTH="OK"
            HEALTH_COLOR="$C_GREEN"
        fi

        if [ "$BUSY" = "N/A" ]; then
            BUSY_DISPLAY="N/A"
        else
            BUSY_DISPLAY="${BUSY}%"
        fi

        printf '  %-8s %-12s %-8s %-9s ' \
            "phy$PHY" \
            "$INT" \
            "$CHANNEL" \
            "$WIDTH"

        printf '%s%-8s%s ' \
            "$HEALTH_COLOR" \
            "$BUSY_DISPLAY" \
            "$C_RESET"

        printf '%-8s %-10s ' \
            "$NOISE" \
            "$TXPOWER"

        printf '%s%s%s\n' \
            "$HEALTH_COLOR" \
            "$HEALTH" \
            "$C_RESET"

    done < "$RADIO_FILE"
}

