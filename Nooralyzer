#!/bin/sh
#
# DNET AP Diagnostic - lightweight Newt replacement
# POSIX /bin/sh, designed for Datto/Kaseya APs.
#
# Usage:
#   curl -fsSL https://raw.githubusercontent.com/ORG/REPO/main/dnet-apdiag.sh | sh
#
# The script intentionally avoids external package dependencies and uses
# standard OpenWrt/BusyBox utilities where possible.
#

VERSION="1.0.0"

# ---------- Output ----------
if [ -t 1 ]; then
    C_GREEN="$(printf '\033[32m')"
    C_YELLOW="$(printf '\033[33m')"
    C_RED="$(printf '\033[31m')"
    C_CYAN="$(printf '\033[36m')"
    C_RESET="$(printf '\033[0m')"
else
    C_GREEN=""
    C_YELLOW=""
    C_RED=""
    C_CYAN=""
    C_RESET=""
fi

ok()   { printf '%s%s%s\n' "$C_GREEN" "$1" "$C_RESET"; }
warn() { printf '%s%s%s\n' "$C_YELLOW" "$1" "$C_RESET"; }
fail() { printf '%s%s%s\n' "$C_RED" "$1" "$C_RESET"; }

section() {
    printf '\n%s=== %s ===%s\n' "$C_CYAN" "$1" "$C_RESET"
}

kv() {
    printf '%-22s %s\n' "$1:" "$2"
}

# ---------- Helpers ----------
have() {
    command -v "$1" >/dev/null 2>&1
}

get_hostname() {
    hostname 2>/dev/null ||
    uci -q get system.@system[0].hostname 2>/dev/null ||
    echo "unknown"
}

get_fw() {
    if have ubus; then
        ubus call system board 2>/dev/null |
            sed -n 's/.*"release":{.*"description":"\([^"]*\)".*/\1/p'
    fi
    [ -n "$REPLY" ] || true
    uci -q get system.@system[0].release.description 2>/dev/null ||
    cat /etc/openwrt_release 2>/dev/null | sed -n 's/^DISTRIB_DESCRIPTION='\''\(.*\)'\''/\1/p'
}

get_model() {
    if [ -r /tmp/sysinfo/model ]; then
        cat /tmp/sysinfo/model
    elif [ -r /sys/firmware/devicetree/base/model ]; then
        tr -d '\000' < /sys/firmware/devicetree/base/model
    else
        echo "unknown"
    fi
}

get_mem_kb() {
    awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null
}

get_mem_free_kb() {
    awk '/^MemAvailable:/ {print $2; found=1; exit}
         /^MemFree:/ && !found {print $2; exit}' /proc/meminfo 2>/dev/null
}

pct() {
    awk -v a="$1" -v b="$2" 'BEGIN {
        if (b <= 0) { print "N/A"; exit }
        printf "%.0f", (a / b) * 100
    }' 2>/dev/null
}

ip4() {
    if have ip; then
        ip -4 -o addr show dev "$1" 2>/dev/null |
            awk '{sub(/\/.*/, "", $4); print $4}'
    elif have ifconfig; then
        ifconfig "$1" 2>/dev/null |
            awk '/inet / {print $2; exit}'
    fi
}

netmask4() {
    if have ip; then
        ip -4 -o addr show dev "$1" 2>/dev/null |
            awk '{print $4; exit}'
    else
        echo "-"
    fi
}

mac() {
    [ -r "/sys/class/net/$1/address" ] && cat "/sys/class/net/$1/address"
}

carrier() {
    [ -r "/sys/class/net/$1/carrier" ] && cat "/sys/class/net/$1/carrier" || echo "?"
}

speed() {
    [ -r "/sys/class/net/$1/speed" ] && cat "/sys/class/net/$1/speed" || echo "?"
}

duplex() {
    [ -r "/sys/class/net/$1/duplex" ] && cat "/sys/class/net/$1/duplex" || echo "?"
}

is_wireless_iface() {
    [ -d "/sys/class/net/$1/phy80211" ] || [ -L "/sys/class/net/$1/phy80211" ]
}

phy_for_iface() {
    if [ -e "/sys/class/net/$1/phy80211/name" ]; then
        cat "/sys/class/net/$1/phy80211/name"
    else
        basename "$(readlink "/sys/class/net/$1/phy80211" 2>/dev/null)" 2>/dev/null
    fi
}

# ---------- System ----------
report_system() {
    section "System Info"

    host="$(get_hostname)"
    model="$(get_model)"
    fw="$(get_fw)"
    uptime_h="$(awk '{printf "%.2f", $1/3600}' /proc/uptime 2>/dev/null)"
    load="$(cat /proc/loadavg 2>/dev/null | awk '{print $1" "$2" "$3}')"

    mem_total="$(get_mem_kb)"
    mem_avail="$(get_mem_free_kb)"
    if [ -n "$mem_total" ] && [ -n "$mem_avail" ]; then
        mem_used=$((mem_total - mem_avail))
        mem_pct="$(pct "$mem_used" "$mem_total")"
        mem_text="${mem_used}KB / ${mem_total}KB (${mem_pct}% used)"
    else
        mem_text="N/A"
    fi

    if df_out="$(df -k /overlay 2>/dev/null | tail -n 1)"; then
        storage="$(printf '%s\n' "$df_out" | awk '{print $3"KB / "$2"KB ("$5" used)"}')"
    else
        storage="N/A"
    fi

    kv "Hostname" "$host"
    kv "Model" "$model"
    kv "Firmware" "$fw"
    kv "Uptime" "${uptime_h} hours"
    kv "Load" "$load"
    kv "Memory" "$mem_text"
    kv "Overlay" "$storage"

    if have sysctl; then
        kv "Conntrack" "$(sysctl -n net.netfilter.nf_conntrack_count 2>/dev/null)/$(sysctl -n net.netfilter.nf_conntrack_max 2>/dev/null)"
    fi
}

# ---------- Wired ----------
report_wired() {
    section "Wired Interfaces"
    printf '%-10s %-6s %-8s %-8s %-8s %-18s %-18s\n' \
        "IF" "Link" "Speed" "Duplex" "MTU" "MAC" "IPv4"

    for d in /sys/class/net/*; do
        [ -e "$d" ] || continue
        intf="${d##*/}"
        is_wireless_iface "$intf" && continue

        # Ignore obvious virtual interfaces for the primary wired report.
        case "$intf" in
            lo|br-*|bond*|sit*|gre*|tun*|tap*) continue ;;
        esac

        link="$(carrier "$intf")"
        [ "$link" = "1" ] && link="UP" || [ "$link" = "0" ] && link="DOWN"

        sp="$(speed "$intf")"
        [ "$sp" = "-1" ] && sp="N/A"
        [ "$sp" != "N/A" ] && [ "$sp" != "?" ] && sp="${sp}Mb"

        mtu="$(cat "/sys/class/net/$intf/mtu" 2>/dev/null)"
        printf '%-10s %-6s %-8s %-8s %-8s %-18s %-18s\n' \
            "$intf" "$link" "$sp" "$(duplex "$intf")" "$mtu" "$(mac "$intf")" "$(ip4 "$intf" | head -n 1)"
    done
}

# ---------- IP ----------
report_ip() {
    section "IP Info"
    printf '%-16s %-18s %-18s\n' "IF" "MAC" "IPv4"

    for d in /sys/class/net/*; do
        [ -e "$d" ] || continue
        intf="${d##*/}"
        addr="$(ip4 "$intf")"
        [ -n "$addr" ] || continue
        printf '%-16s %-18s %s\n' "$intf" "$(mac "$intf")" "$addr"
    done
}

# ---------- Processes ----------
report_processes() {
    section "Process Check"

    # These are intentionally configurable. Firmware-specific additions can
    # be made here without changing the rest of the script.
    good="dnsmasq hostapd"
    [ -x /usr/bin/dashboard_controller ] || [ -x /sbin/dashboard_controller ] && good="$good dashboard_controller"
    [ -x /usr/bin/connkeeper ] || [ -x /sbin/connkeeper ] && good="$good connkeeper"
    [ -x /usr/bin/udshape ] || [ -x /sbin/udshape ] && good="$good udshape"
    [ -x /usr/bin/udsplash ] || [ -x /sbin/udsplash ] && good="$good udsplash"

    bad="anyip juggler"

    printf '%-24s %-8s %s\n' "Process" "Running" "Status"

    for p in $good; do
        if pgrep "$p" >/dev/null 2>&1; then
            printf '%-24s %-8s ' "$p" "YES"
            ok "OK"
        else
            printf '%-24s %-8s ' "$p" "NO"
            fail "IMPORTANT PROCESS NOT RUNNING"
        fi
    done

    for p in $bad; do
        if pgrep "$p" >/dev/null 2>&1; then
            printf '%-24s %-8s ' "$p" "YES"
            warn "POTENTIAL PROBLEM"
        else
            printf '%-24s %-8s ' "$p" "NO"
            ok "OK"
        fi
    done
}

# ---------- Logs ----------
log_count() {
    pattern="$1"
    if have logread; then
        logread 2>/dev/null | grep -c "$pattern"
    else
        echo "0"
    fi
}

report_logs() {
    section "Log Tests"

    printf '%-22s %-8s %-8s %s\n' "Test" "Found" "Count" "Comment"

    check_log() {
        name="$1"
        pattern="$2"
        comment="$3"
        count="$(log_count "$pattern")"
        if [ "${count:-0}" -gt 0 ] 2>/dev/null; then
            printf '%-22s ' "$name"
            fail "YES"
            printf '%-8s %s\n' "$count" "$comment"
        else
            printf '%-22s ' "$name"
            ok "NO"
            printf '%-8s %s\n' "0" "None"
        fi
    }

    check_log "Link Beat" "Link beat lost" "link beat lost events detected"
    check_log "Check-in Fail" "dashboard check-in failed" "dashboard check-in failures detected"
    check_log "Looping" "with own address as source address" "loop events detected"
    check_log "inet_unavailable" "inet_unavailable" "inet_unavailable events detected"
    check_log "Reconfigs" "event: enable_all" "reconfiguration events detected"
    check_log "Delayed Config" "applying delayed config" "delayed configuration detected"
    check_log "Package Parse" "Download Packages.gz from private feed fail" "package feed failures detected"
}

# ---------- Radio / clients ----------
get_wifi_ifaces() {
    for d in /sys/class/net/*; do
        [ -e "$d" ] || continue
        intf="${d##*/}"
        is_wireless_iface "$intf" && printf '%s\n' "$intf"
    done
}

report_radio_busy() {
    section "Radio Busy Time"

    if ! have iw; then
        warn "iw is not installed"
        return
    fi

    printf '%-10s %-10s %-12s %-12s %-10s\n' "PHY" "IF" "Channel" "Busy" "Status"

    for phy in $(ls /sys/class/ieee80211 2>/dev/null); do
        intf=""
        for w in $(get_wifi_ifaces); do
            [ "$(phy_for_iface "$w")" = "$phy" ] && { intf="$w"; break; }
        done

        [ -n "$intf" ] || {
            printf '%-10s %-10s %-12s %-12s ' "$phy" "-" "-" "N/A"
            warn "NO AP INTERFACE"
            continue
        }

        survey="$(iw dev "$intf" survey dump 2>/dev/null)"
        active="$(printf '%s\n' "$survey" | awk '/channel active time:/ {print $4; exit}')"
        busy="$(printf '%s\n' "$survey" | awk '/channel busy time:/ {print $4; exit}')"
        channel="$(iw dev "$intf" info 2>/dev/null | awk '/channel/ {print $2; exit}')"

        if [ -n "$active" ] && [ -n "$busy" ] && [ "$active" -gt 0 ] 2>/dev/null; then
            busy_pct="$(awk -v b="$busy" -v a="$active" 'BEGIN {printf "%.0f", (b/a)*100}')"
            if [ "$busy_pct" -gt 60 ] 2>/dev/null; then
                status="HIGH"
                color="$C_RED"
            elif [ "$busy_pct" -gt 40 ] 2>/dev/null; then
                status="ELEVATED"
                color="$C_YELLOW"
            else
                status="OK"
                color="$C_GREEN"
            fi
            printf '%-10s %-10s %-12s %s%-12s%s %s%s%s\n' \
                "$phy" "$intf" "${channel:-?}" "${color}" "${busy_pct}%" "$C_RESET" "$color" "$status" "$C_RESET"
        else
            printf '%-10s %-10s %-12s %-12s ' "$phy" "$intf" "${channel:-?}" "N/A"
            warn "SURVEY DATA UNAVAILABLE"
        fi
    done
}

station_count() {
    iw "$1" station dump 2>/dev/null |
        awk '/^Station ([0-9a-fA-F:]+)/ {count++} END {print count+0}'
}

report_clients() {
    section "Wi-Fi Clients"

    if ! have iw; then
        warn "iw is not installed"
        return
    fi

    total=0
    for w in $(get_wifi_ifaces); do
        c="$(station_count "$w")"
        total=$((total + c))
        printf '%-16s clients: %s\n' "$w" "$c"
    done

    printf 'Total clients: %s\n' "$total"
    printf '\n%-16s %-18s %-8s %-16s %-12s %-12s\n' \
        "IF" "MAC" "RSSI" "TX Rate" "Band" "Inactive"

    for w in $(get_wifi_ifaces); do
        iw "$w" station dump 2>/dev/null |
        awk -v intf="$w" '
            /^Station / {
                mac=$2; rssi=""; tx=""; inactive="";
                getline; while ($0 !~ /^Station / && $0 != "") {
                    if ($1=="inactive") inactive=$3;
                    if ($1=="signal:") rssi=$2;
                    if ($1=="tx" && $2=="bitrate:") tx=$3" "$4;
                    if ($1=="rx" && $2=="bitrate:" && tx=="") tx=$3" "$4;
                    if ((getline <= 0) || $0=="") break;
                }
                if (mac!="") print intf, mac, rssi, tx, "-", inactive;
            }
        ' | while read intf macaddr rssi tx band inactive; do
            printf '%-16s %-18s %-8s %-16s %-12s %-12s\n' \
                "$intf" "$macaddr" "$rssi" "$tx" "$band" "$inactive"
        done
    done
}

# ---------- AP state ----------
report_state() {
    section "AP State"

    issues=0

    for required in iw pgrep logread; do
        if have "$required"; then
            printf '%-28s ' "Dependency: $required"
            ok "OK"
        else
            printf '%-28s ' "Dependency: $required"
            warn "MISSING"
        fi
    done

    if [ -d /sys/class/ieee80211 ]; then
        phy_count="$(ls /sys/class/ieee80211 2>/dev/null | wc -w | tr -d ' ')"
    else
        phy_count=0
    fi

    if [ "$phy_count" -gt 0 ]; then
        printf '%-28s ' "Wireless PHYs"
        ok "$phy_count detected"
    else
        printf '%-28s ' "Wireless PHYs"
        fail "NONE DETECTED"
        issues=$((issues + 1))
    fi

    if ip route 2>/dev/null | grep -q '^default '; then
        printf '%-28s ' "Default route"
        ok "Present"
    else
        printf '%-28s ' "Default route"
        fail "MISSING"
        issues=$((issues + 1))
    fi

    if [ -s /etc/resolv.conf ]; then
        printf '%-28s ' "DNS configuration"
        ok "Present"
    else
        printf '%-28s ' "DNS configuration"
        warn "Missing/empty"
        issues=$((issues + 1))
    fi

    printf '\nState summary: '
    if [ "$issues" -eq 0 ]; then
        ok "NO BASIC STATE ISSUES DETECTED"
    else
        fail "$issues BASIC ISSUE(S) DETECTED"
    fi
}

# ---------- Main ----------
printf '\n'
printf '%sDNET AP DIAGNOSTIC v%s%s\n' "$C_CYAN" "$VERSION" "$C_RESET"
printf 'Host: %s\n' "$(get_hostname)"
printf 'Started: %s\n' "$(date -u '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null)"

report_system
report_wired
report_ip
report_processes
report_logs
report_state
report_radio_busy
report_clients

printf '\n%sDiagnostic complete.%s\n' "$C_CYAN" "$C_RESET"
