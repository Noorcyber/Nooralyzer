#!/bin/sh

# ================================================================
# NOORALYZER v1.7
# DNET AP Diagnostic & Troubleshooting Tool
#
# Read-only diagnostics for Datto/Kaseya Networking APs
# ================================================================

VERSION="1.7"
TMP_BASE="/tmp/nooralyzer.$$"

# ================================================================
# COLORS
# ================================================================

if [ -t 1 ]; then
    C_CYAN="$(printf '\033[36m')"
    C_BLUE="$(printf '\033[34m')"
    C_GREEN="$(printf '\033[32m')"
    C_YELLOW="$(printf '\033[33m')"
    C_RED="$(printf '\033[31m')"
    C_WHITE="$(printf '\033[37m')"
    C_DIM="$(printf '\033[2m')"
    C_RESET="$(printf '\033[0m')"
else
    C_CYAN=""
    C_BLUE=""
    C_GREEN=""
    C_YELLOW=""
    C_RED=""
    C_WHITE=""
    C_DIM=""
    C_RESET=""
fi

# ================================================================
# COUNTERS
# ================================================================

ISSUES=0
WARNINGS=0
INFO_COUNT=0

cleanup() {
    rm -f "${TMP_BASE}"* 2>/dev/null
}

trap cleanup EXIT INT TERM

# ================================================================
# HELPERS
# ================================================================

have() {
    command -v "$1" >/dev/null 2>&1
}

binary_exists() {
    command -v "$1" >/dev/null 2>&1 ||
    [ -x "/usr/bin/$1" ] ||
    [ -x "/usr/sbin/$1" ] ||
    [ -x "/sbin/$1" ]
}

# Section metadata. Actual rendering is performed by run_panel() so every
# diagnostic section gets a clean, fully enclosed box while preserving the
# existing diagnostic output and colors.
PANEL_TITLE=""
PANEL_HINT="normal"

section() {
    PANEL_TITLE="$1"
    PANEL_HINT="normal"
}

section_wide() {
    PANEL_TITLE="$1"
    PANEL_HINT="wide"
}

repeat_char() {
    CHAR="$1"
    COUNT="$2"

    [ "$COUNT" -gt 0 ] 2>/dev/null || return 0
    printf '%*s' "$COUNT" '' | tr ' ' "$CHAR"
}

strip_ansi() {
    ESC="$(printf '\033')"
    sed "s/${ESC}\[[0-9;]*m//g"
}

panel_visual_length() {
    printf '%s' "$1" | strip_ansi | awk '{print length}'
}

render_panel() {
    FILE="$1"
    TITLE="$PANEL_TITLE"

    [ -f "$FILE" ] || return 0

    WIDTH=0
    TITLE_LEN="$(panel_visual_length "$TITLE")"

    if [ "$TITLE_LEN" -gt "$WIDTH" ] 2>/dev/null; then
        WIDTH="$TITLE_LEN"
    fi

    while IFS= read -r LINE || [ -n "$LINE" ]; do
        LEN="$(panel_visual_length "$LINE")"
        if [ "$LEN" -gt "$WIDTH" ] 2>/dev/null; then
            WIDTH="$LEN"
        fi
    done < "$FILE"

    # Keep the compact sections compact while allowing wide diagnostic
    # tables (SSID, client quality, process resources, etc.) to breathe.
    if [ "$PANEL_HINT" = "wide" ] && [ "$WIDTH" -lt 112 ] 2>/dev/null; then
        WIDTH=112
    elif [ "$WIDTH" -lt 68 ] 2>/dev/null; then
        WIDTH=68
    fi

    BORDER_LEN=$((WIDTH + 2))
    RULE="$(repeat_char '-' "$BORDER_LEN")"

    printf '\n%s+%s+%s\n' "$C_CYAN" "$RULE" "$C_RESET"

    TITLE_PAD=$((WIDTH - TITLE_LEN))
    [ "$TITLE_PAD" -lt 0 ] && TITLE_PAD=0

    printf '%s| %s%*s |%s\n' \
        "$C_CYAN" "$TITLE" "$TITLE_PAD" '' "$C_RESET"

    printf '%s+%s+%s\n' "$C_CYAN" "$RULE" "$C_RESET"

    while IFS= read -r LINE || [ -n "$LINE" ]; do
        LEN="$(panel_visual_length "$LINE")"
        PAD=$((WIDTH - LEN))
        [ "$PAD" -lt 0 ] && PAD=0

        printf '%s| %s%*s |%s\n' \
            "$C_WHITE" "$LINE" "$PAD" '' "$C_RESET"
    done < "$FILE"

    printf '%s+%s+%s\n' "$C_CYAN" "$RULE" "$C_RESET"
}

run_panel() {
    FUNC="$1"
    PANEL_FILE="${TMP_BASE}_panel_${FUNC}"

    PANEL_TITLE=""
    PANEL_HINT="normal"

    "$FUNC" > "$PANEL_FILE" 2>&1

    if [ -n "$PANEL_TITLE" ]; then
        render_panel "$PANEL_FILE"
    else
        cat "$PANEL_FILE"
    fi

    rm -f "$PANEL_FILE" 2>/dev/null
}

kv() {
    printf '  %-25s %s\n' "$1" "$2"
}

ok() {
    printf '%s[ OK ]%s %s\n' "$C_GREEN" "$C_RESET" "$1"
}

warn() {
    WARNINGS=$((WARNINGS + 1))
    printf '%s[ !! ]%s %s\n' "$C_YELLOW" "$C_RESET" "$1"
}

issue() {
    ISSUES=$((ISSUES + 1))
    printf '%s[FAIL]%s %s\n' "$C_RED" "$C_RESET" "$1"
}

skip() {
    printf '%s[ -- ]%s %s\n' "$C_DIM" "$C_RESET" "$1"
}

info() {
    INFO_COUNT=$((INFO_COUNT + 1))
    printf '%s[INFO]%s %s\n' "$C_CYAN" "$C_RESET" "$1"
}

read_sys() {
    FILE="$1"

    if [ -r "$FILE" ]; then
        cat "$FILE" 2>/dev/null
    fi
}

get_hostname() {
    hostname 2>/dev/null || echo "unknown"
}

get_model() {
    if [ -r /tmp/sysinfo/model ]; then
        cat /tmp/sysinfo/model 2>/dev/null
    elif [ -r /sys/firmware/devicetree/base/model ]; then
        tr -d '\000' < /sys/firmware/devicetree/base/model 2>/dev/null
    else
        echo "unknown"
    fi
}

get_firmware() {
    if [ -r /etc/fw_core_version ]; then
        tr -d '[:space:]' < /etc/fw_core_version 2>/dev/null
    else
        echo "Not exposed"
    fi
}

get_uptime() {
    awk '{printf "%.2f hours", $1/3600}' /proc/uptime 2>/dev/null
}

get_load() {
    awk '{print $1" "$2" "$3}' /proc/loadavg 2>/dev/null
}

get_mem_total() {
    awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null
}

get_mem_available() {
    awk '/^MemAvailable:/ {print $2; exit}' /proc/meminfo 2>/dev/null
}

get_ipv4() {
    INT="$1"

    if have ip; then
        ip -4 -o addr show dev "$INT" 2>/dev/null |
            awk '{split($4,A,"/"); print A[1]; exit}'
    fi
}

get_mac() {
    INT="$1"

    if [ -r "/sys/class/net/$INT/address" ]; then
        cat "/sys/class/net/$INT/address" 2>/dev/null
    fi
}

get_carrier() {
    read_sys "/sys/class/net/$1/carrier"
}

get_speed() {
    read_sys "/sys/class/net/$1/speed"
}

get_duplex() {
    read_sys "/sys/class/net/$1/duplex"
}

# ================================================================
# SYSTEM
# ================================================================

report_system() {

    section "SYSTEM HEALTH"

    MEM_TOTAL="$(get_mem_total)"
    MEM_AVAIL="$(get_mem_available)"

    if [ -n "$MEM_TOTAL" ] &&
       [ -n "$MEM_AVAIL" ] &&
       [ "$MEM_TOTAL" -gt 0 ] 2>/dev/null
    then
        MEM_USED=$((MEM_TOTAL - MEM_AVAIL))

        MEM_PCT="$(awk \
            -v u="$MEM_USED" \
            -v t="$MEM_TOTAL" \
            'BEGIN {printf "%.0f",(u/t)*100}'
        )"

        kv "Memory" "${MEM_PCT}% used (${MEM_AVAIL} KB available)"
    else
        kv "Memory" "N/A"
    fi

    OVERLAY="$(df -k /overlay 2>/dev/null | tail -n 1)"

    if [ -n "$OVERLAY" ]; then
        OVERLAY_USE="$(printf '%s\n' "$OVERLAY" | awk '{print $5}')"
        kv "Overlay" "$OVERLAY_USE used"
    else
        kv "Overlay" "N/A"
    fi

    if [ -r /proc/sys/net/netfilter/nf_conntrack_count ] &&
       [ -r /proc/sys/net/netfilter/nf_conntrack_max ]
    then

        CT_COUNT="$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null)"
        CT_MAX="$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null)"

        kv "Conntrack" "$CT_COUNT / $CT_MAX"
    else
        kv "Conntrack" "N/A"
    fi

    kv "Hostname" "$(get_hostname)"
    kv "Model" "$(get_model)"
    kv "Firmware" "$(get_firmware)"
    kv "Uptime" "$(get_uptime)"
    kv "Load" "$(get_load)"

    if [ -r /sys/class/thermal/thermal_zone0/temp ]; then

        TEMP="$(awk '{printf "%.0f",$1/1000}' \
            /sys/class/thermal/thermal_zone0/temp 2>/dev/null)"

        if [ -n "$TEMP" ]; then

            if [ "$TEMP" -ge 85 ] 2>/dev/null; then
                issue "CPU temperature ${TEMP}C is HIGH"

            elif [ "$TEMP" -ge 75 ] 2>/dev/null; then
                warn "CPU temperature ${TEMP}C is elevated"

            else
                ok "CPU temperature ${TEMP}C"
            fi

        fi
    else
        skip "CPU temperature not exposed by this platform"
    fi
}

# ================================================================
# PHYSICAL ETHERNET
# ================================================================

is_physical_ethernet() {

    INT="$1"

    case "$INT" in
        eth*|lan*|wan*)
            ;;
        *)
            return 1
            ;;
    esac

    [ -e "/sys/class/net/$INT/device" ] || return 1

    [ ! -e "/sys/class/net/$INT/phy80211" ] || return 1

    return 0
}

# ================================================================
# ETHERNET MAX CAPABILITY
# ================================================================

get_capability() {

    INT="$1"

    # Prefer ethtool because it exposes supported link modes.
    if have ethtool; then

        CAP="$(
            ethtool "$INT" 2>/dev/null |
            awk '
                /Supported link modes:/ {
                    START=1
                    next
                }

                START {
                    if ($0 !~ /^[[:space:]]/) {
                        START=0
                        next
                    }

                    for (i=1; i<=NF; i++) {
                        if ($i ~ /^[0-9]+base[TXF]+\/?[Ff]?[Hh]?$/) {
                            V=$i
                            sub(/base.*/, "", V)
                            if (V+0 > MAX)
                                MAX=V+0
                        }
                    }
                }

                END {
                    if (MAX > 0)
                        print MAX
                }
            '
        )"

        if [ -n "$CAP" ]; then
            printf '%s Mbps\n' "$CAP"
            return 0
        fi

        # Alternative ethtool format.
        CAP="$(
            ethtool "$INT" 2>/dev/null |
            grep -Eo '[0-9]+(base10|base100|base1000|base2500|base5000|base10000)' |
            sed 's/base.*//' |
            sort -n |
            tail -n 1
        )"

        if [ -n "$CAP" ]; then
            printf '%s Mbps\n' "$CAP"
            return 0
        fi
    fi

    printf 'N/A\n'
}

# ================================================================
# HARDWARE ETHERNET PROFILE
#
# Mirrors the hardware expectations used by the original Newt tool.
# The current negotiated values still come from the AP itself, while
# the Max/Uplink/PoE fields come from the verified hardware profile.
# ================================================================

get_hw_eth_profile() {
    INT="$1"

    MODEL="$(get_model | tr '[:lower:]' '[:upper:]' 2>/dev/null)"

    EXPECTED="N/A"
    POE="N/A"

    case "$MODEL" in
        *AP840E*)
            case "$INT" in
                eth0) EXPECTED="1000"; POE="none" ;;
                eth1) EXPECTED="2500"; POE="802.3at" ;;
            esac
            ;;

        *AP840*)
            case "$INT" in
                eth0) EXPECTED="1000"; POE="none" ;;
                eth1) EXPECTED="2500"; POE="802.3at" ;;
            esac
            ;;

        *AP440*)
            case "$INT" in
                eth0) EXPECTED="1000"; POE="802.3at" ;;
                eth1) EXPECTED="1000"; POE="none" ;;
            esac
            ;;

        *A62*)
            case "$INT" in
                eth0|eth1) EXPECTED="1000"; POE="802.3af passive" ;;
            esac
            ;;

        *A60*|*A40*)
            case "$INT" in
                eth0) EXPECTED="1000"; POE="802.3af" ;;
                eth1) EXPECTED="1000"; POE="none" ;;
            esac
            ;;

        *A42*)
            case "$INT" in
                eth0|eth1) EXPECTED="1000"; POE="802.3af passive" ;;
            esac
            ;;

        *OM5P_AN*)
            case "$INT" in
                eth0) EXPECTED="1000"; POE="802.3af" ;;
                eth1) EXPECTED="100"; POE="passive" ;;
            esac
            ;;

        *OM5P_AC*)
            case "$INT" in
                eth0|eth1) EXPECTED="1000"; POE="802.3af passive" ;;
            esac
            ;;

        *OM2P_HS*)
            case "$INT" in
                eth0) EXPECTED="100"; POE="802.3af" ;;
                eth1) EXPECTED="100"; POE="passive" ;;
            esac
            ;;

        *OM2P_LC*|*OM2P*)
            case "$INT" in
                eth0) EXPECTED="100"; POE="passive" ;;
                eth1) EXPECTED="100"; POE="none" ;;
            esac
            ;;

        *MR600*|*MR900*|*MR1750*)
            case "$INT" in
                eth0) EXPECTED="1000"; POE="802.3af" ;;
            esac
            ;;
    esac

    printf '%s|%s\n' "$EXPECTED" "$POE"
}

get_uplink_eth() {
    UPLINK=""

    # AP440/AP840/AP840E hardware uses the br-wired0/br-wired1
    # bridge carrying an IPv4 address to identify the uplink port.
    if [ -d /sys/class/net/br-wired0 ]; then
        if [ -n "$(get_ipv4 br-wired0)" ]; then
            UPLINK="eth0"
        fi
    fi

    if [ -d /sys/class/net/br-wired1 ]; then
        if [ -n "$(get_ipv4 br-wired1)" ]; then
            UPLINK="eth1"
        fi
    fi

    # Legacy models use br-lan1/br-lan2.
    if [ -z "$UPLINK" ]; then
        if [ -d /sys/class/net/br-lan1 ]; then
            if [ -n "$(get_ipv4 br-lan1)" ]; then
                UPLINK="eth0"
            fi
        fi

        if [ -d /sys/class/net/br-lan2 ]; then
            if [ -n "$(get_ipv4 br-lan2)" ]; then
                UPLINK="eth1"
            fi
        fi
    fi

    printf '%s\n' "$UPLINK"
}

get_eth_max_speed() {
    INT="$1"
    PROFILE="$(get_hw_eth_profile "$INT")"
    EXPECTED="${PROFILE%%|*}"

    if [ -n "$EXPECTED" ] && [ "$EXPECTED" != "N/A" ]; then
        printf '%s\n' "$EXPECTED"
        return 0
    fi

    # Unknown model fallback: use the existing ethtool capability
    # parser if the AP happens to provide ethtool.
    CAP="$(get_capability "$INT")"
    case "$CAP" in
        *Mbps)
            printf '%s\n' "${CAP% Mbps}"
            ;;
        *)
            printf 'N/A\n'
            ;;
    esac
}

get_eth_poe() {
    INT="$1"
    PROFILE="$(get_hw_eth_profile "$INT")"
    POE="${PROFILE#*|}"
    printf '%s\n' "$POE"
}

normalize_eth_speed() {
    SPEED="$1"

    case "$SPEED" in
        10000|5000|2500|1000|100|10)
            printf '%s\n' "$SPEED"
            ;;
        *)
            printf '????\n'
            ;;
    esac
}

normalize_eth_duplex() {
    DUPLEX="$1"

    case "$DUPLEX" in
        half|full)
            printf '%s\n' "$DUPLEX"
            ;;
        *)
            printf '????\n'
            ;;
    esac
}

report_wired() {

    # Match the original Newt Ethernet table layout:
    # If / Link / Speed / Max / Duplex / Uplink / PoE / MAC / Warnings
    section_wide "UPLINK / ETHERNET"

    printf '  %-8s %-6s %-8s %-8s %-10s %-7s %-16s %-20s %s\n' \
        "If" "Link" "Speed" "Max" "Duplex" "Uplink" "PoE" "MAC" "Warnings"

    printf '  %-8s %-6s %-8s %-8s %-10s %-7s %-16s %-20s %s\n' \
        "--------" "------" "--------" "--------" "----------" "-------" \
        "----------------" "--------------------" "------------------------------"

    FOUND=0
    UPLINK_ETH="$(get_uplink_eth)"

    for D in /sys/class/net/*; do

        [ -e "$D" ] || continue

        INT="${D##*/}"

        is_physical_ethernet "$INT" || continue

        FOUND=1

        CARRIER="$(get_carrier "$INT")"
        RAW_SPEED="$(get_speed "$INT")"
        RAW_DUPLEX="$(get_duplex "$INT")"
        MAX_SPEED="$(get_eth_max_speed "$INT")"
        POE="$(get_eth_poe "$INT")"
        MAC="$(get_mac "$INT")"

        [ -n "$MAC" ] || MAC="-"
        [ -n "$MAX_SPEED" ] || MAX_SPEED="N/A"
        [ -n "$POE" ] || POE="N/A"

        SPEED="$(normalize_eth_speed "$RAW_SPEED")"
        DUPLEX="$(normalize_eth_duplex "$RAW_DUPLEX")"

        case "$CARRIER" in
            1) LINK="1" ;;
            0) LINK="0" ;;
            *) LINK="?" ;;
        esac

        UPLINK="0"
        if [ "$UPLINK_ETH" = "$INT" ]; then
            UPLINK="1"
        fi

        WARNINGS_TEXT=""
        WARNING_DISPLAY=""

        # Match original Newt logic: only evaluate negotiated speed and
        # duplex when the physical link is actually up.
        if [ "$CARRIER" = "1" ]; then

            if [ "$MAX_SPEED" != "N/A" ] &&
               [ "$SPEED" != "????" ] &&
               [ "$SPEED" != "$MAX_SPEED" ]
            then
                WARNINGS_TEXT="[not max speed]"
            fi

            if [ "$DUPLEX" != "full" ]; then
                if [ -n "$WARNINGS_TEXT" ]; then
                    WARNINGS_TEXT="$WARNINGS_TEXT [half duplex]"
                else
                    WARNINGS_TEXT="[half duplex]"
                fi
            fi
        fi

        if [ -z "$WARNINGS_TEXT" ]; then
            printf '  %-8s %-6s %-8s %-8s %-10s %-7s %-16s %-20s ' \
                "$INT" "$LINK" "$SPEED" "$MAX_SPEED" "$DUPLEX" "$UPLINK" "$POE" "$MAC"
            printf '%snone%s\n' "$C_GREEN" "$C_RESET"
        else
            printf '  %-8s %-6s %-8s %-8s %-10s %-7s %-16s %-20s ' \
                "$INT" "$LINK" "$SPEED" "$MAX_SPEED" "$DUPLEX" "$UPLINK" "$POE" "$MAC"
            printf '%s%s%s\n' "$C_RED" "$WARNINGS_TEXT" "$C_RESET"
        fi

        # Preserve Nooralyzer diagnostic counters for actual active-link
        # problems, while avoiding warnings for a disconnected port.
        if [ "$CARRIER" = "1" ]; then

            if [ "$SPEED" = "10" ]; then
                issue "$INT negotiated at only 10 Mbps"
            elif [ "$SPEED" = "100" ]; then
                warn "$INT negotiated at 100 Mbps"
            fi

            if [ "$DUPLEX" = "half" ]; then
                issue "$INT is running HALF duplex"
            fi

            if [ "$MAX_SPEED" != "N/A" ] &&
               [ "$SPEED" != "????" ] &&
               [ "$SPEED" != "$MAX_SPEED" ]
            then
                warn "$INT is capable of ${MAX_SPEED} Mbps but currently negotiated at ${SPEED} Mbps"
            fi
        fi
    done

    [ "$FOUND" -eq 1 ] ||
        skip "No physical Ethernet interfaces detected"
}

# ================================================================
# ETHERNET ERRORS
# ================================================================

stat_value() {
    read_sys "/sys/class/net/$1/statistics/$2"
}

report_ethernet_errors() {

    section "ETHERNET ERROR COUNTERS"

    printf '  %-8s %-9s %-9s %-9s %-9s %-9s %s\n' \
        "IF" "RX ERR" "TX ERR" "RX DROP" "TX DROP" "CARRIER" "HEALTH"

    printf '  %-8s %-9s %-9s %-9s %-9s %-9s %s\n' \
        "--------" "---------" "---------" "---------" \
        "---------" "---------" "----------"

    FOUND=0

    for D in /sys/class/net/*; do

        [ -e "$D" ] || continue

        INT="${D##*/}"

        is_physical_ethernet "$INT" || continue

        FOUND=1

        RXERR="$(stat_value "$INT" rx_errors)"
        TXERR="$(stat_value "$INT" tx_errors)"
        RXDROP="$(stat_value "$INT" rx_dropped)"
        TXDROP="$(stat_value "$INT" tx_dropped)"
        CARRIER="$(stat_value "$INT" carrier)"

        [ -n "$RXERR" ] || RXERR=0
        [ -n "$TXERR" ] || TXERR=0
        [ -n "$RXDROP" ] || RXDROP=0
        [ -n "$TXDROP" ] || TXDROP=0
        [ -n "$CARRIER" ] || CARRIER=0

        HEALTH="OK"

        if [ "$RXERR" -gt 0 ] 2>/dev/null ||
           [ "$TXERR" -gt 0 ] 2>/dev/null ||
           [ "$CARRIER" -gt 0 ] 2>/dev/null
        then
            HEALTH="WARN"
        fi

        if [ "$RXERR" -gt 100 ] 2>/dev/null ||
           [ "$TXERR" -gt 100 ] 2>/dev/null ||
           [ "$CARRIER" -gt 20 ] 2>/dev/null
        then
            HEALTH="HIGH"
        fi

        printf '  %-8s %-9s %-9s %-9s %-9s %-9s %s\n' \
            "$INT" "$RXERR" "$TXERR" "$RXDROP" "$TXDROP" "$CARRIER" "$HEALTH"

        if [ "$HEALTH" = "HIGH" ]; then
            issue "$INT has high Ethernet error/carrier counts"
        elif [ "$HEALTH" = "WARN" ]; then
            warn "$INT has Ethernet errors or carrier events"
        fi
    done

    [ "$FOUND" -eq 1 ] ||
        skip "No physical Ethernet interfaces available"
}

# ================================================================
# INTERFACE / IP MAP
# ================================================================

report_ip() {

    section "INTERFACE / IP MAP"

    printf '  %-18s %-20s %s\n' \
        "INTERFACE" "MAC" "IPv4"

    printf '  %-18s %-20s %s\n' \
        "------------------" "--------------------" "----------------"

    for D in /sys/class/net/*; do

        [ -e "$D" ] || continue

        INT="${D##*/}"

        ADDR="$(get_ipv4 "$INT")"

        [ -n "$ADDR" ] || continue

        printf '  %-18s %-20s %s\n' \
            "$INT" "$(get_mac "$INT")" "$ADDR"
    done
}

# ================================================================
# PING
# ================================================================

ping_test() {

    TARGET="$1"
    COUNT="$2"

    if ! have ping; then
        return 2
    fi

    PING_FILE="${TMP_BASE}_ping"

    ping -c "$COUNT" -W 2 "$TARGET" >"$PING_FILE" 2>&1

    RC=$?

    if [ "$RC" -ne 0 ]; then
        return 1
    fi

    LOSS="$(
        awk -F',' '
            /packet loss/ {
                for(i=1;i<=NF;i++) {
                    if($i ~ /packet loss/) {
                        gsub(/%/,"",$i)
                        gsub(/[^0-9.]/,"",$i)
                        print $i
                        exit
                    }
                }
            }
        ' "$PING_FILE" 2>/dev/null
    )"

    LATENCY="$(
        awk -F'=' '
            /round-trip|rtt/ {
                gsub(/ /,"",$2)
                split($2,A,"/")
                print A[2]
                exit
            }
        ' "$PING_FILE" 2>/dev/null
    )"

    [ -n "$LOSS" ] || LOSS="0"
    [ -n "$LATENCY" ] || LATENCY="N/A"

    printf '%s|%s' "$LOSS" "$LATENCY"

    return 0
}

# ================================================================
# CONNECTIVITY
# ================================================================

get_default_gateway() {

    if have ip; then
        ip route 2>/dev/null |
            awk '$1=="default"{print $3; exit}'
    fi
}

report_connectivity() {

    section "CONNECTIVITY HEALTH"

    GATEWAY="$(get_default_gateway)"

    printf '  %-25s ' "Default gateway"

    if [ -n "$GATEWAY" ]; then
        ok "$GATEWAY"
    else
        skip "No default gateway exposed"
    fi

    printf '  %-25s ' "Gateway reachability"

    if [ -n "$GATEWAY" ] && have ping; then

        RESULT="$(ping_test "$GATEWAY" 3)"

        if [ $? -eq 0 ]; then

            LOSS="${RESULT%%|*}"
            LATENCY="${RESULT#*|}"

            if [ "$LOSS" = "0" ] || [ "$LOSS" = "0.0" ]; then
                ok "Reachable - ${LATENCY} ms average"
            else
                warn "Gateway packet loss: ${LOSS}%"
            fi
        else
            warn "Gateway ICMP test failed or blocked"
        fi

    else
        skip "Gateway test unavailable"
    fi

    printf '  %-25s ' "Internet 1.1.1.1"

    if have ping; then

        RESULT="$(ping_test 1.1.1.1 3)"

        if [ $? -eq 0 ]; then

            LOSS="${RESULT%%|*}"
            LATENCY="${RESULT#*|}"

            if [ "$LOSS" = "0" ] || [ "$LOSS" = "0.0" ]; then
                ok "Reachable - ${LATENCY} ms average"
            else
                warn "Internet packet loss: ${LOSS}%"
            fi
        else
            warn "Internet ICMP failed or blocked"
        fi

    else
        skip "ping not installed"
    fi

    DNS_SERVERS=""

    if [ -s /etc/resolv.conf ]; then

        DNS_SERVERS="$(
            awk '
                /^[[:space:]]*nameserver[[:space:]]+/ {
                    if(n++) printf ", "
                    printf $2
                }
            ' /etc/resolv.conf 2>/dev/null
        )"

    fi

    printf '  %-25s ' "DNS servers"

    if [ -n "$DNS_SERVERS" ]; then
        ok "$DNS_SERVERS"
    else
        warn "No nameserver configured"
    fi

    printf '  %-25s ' "DNS resolution"

    if have nslookup; then

        if nslookup cloudflare.com >"${TMP_BASE}_dns" 2>&1 &&
           grep -q "Address" "${TMP_BASE}_dns"
        then
            ok "cloudflare.com resolved"
        else
            warn "DNS resolution failed"
        fi

    elif have ping; then

        if ping -c 1 -W 2 cloudflare.com >/dev/null 2>&1; then
            ok "cloudflare.com resolved"
        else
            warn "DNS resolution failed"
        fi

    else
        skip "No DNS-capable utility available"
    fi

    printf '  %-25s ' "HTTPS connectivity"

    if have curl; then

        HTTP_CODE="$(
            curl -k -sS \
                -L \
                --connect-timeout 3 \
                --max-time 6 \
                -o /dev/null \
                -w '%{http_code}' \
                https://www.cloudflare.com/ \
                2>/dev/null
        )"

        case "$HTTP_CODE" in
            2*|3*)
                ok "HTTPS reachable (HTTP $HTTP_CODE)"
                ;;
            000|"")
                warn "HTTPS connection failed"
                ;;
            *)
                warn "HTTPS returned HTTP $HTTP_CODE"
                ;;
        esac

    elif have wget; then

        if wget -q -T 6 -O /dev/null \
            https://www.cloudflare.com/ 2>/dev/null
        then
            ok "HTTPS reachable"
        else
            warn "HTTPS connection failed"
        fi

    else
        skip "curl/wget not installed"
    fi
}

# ================================================================
# NETWORK STATE
# ================================================================

report_network_state() {

    section "NETWORK STATE"

    if have ip; then

        ROUTES="$(ip route 2>/dev/null)"

        DEFAULT="$(
            printf '%s\n' "$ROUTES" |
            awk '$1=="default"{print $0; exit}'
        )"

        printf '  %-25s ' "Default route"

        if [ -n "$DEFAULT" ]; then
            ok "$DEFAULT"
        else
            skip "No default route exposed"
        fi

        ROUTE_COUNT="$(
            printf '%s\n' "$ROUTES" |
            grep -c '^[0-9]' 2>/dev/null
        )"

        printf '  %-25s ' "IPv4 routes"

        if [ -n "$ROUTE_COUNT" ]; then
            ok "$ROUTE_COUNT route(s)"
        else
            info "Unavailable"
        fi

        FAILED="$(
            ip neigh 2>/dev/null |
            grep -ci "FAILED" |
            tr -d ' '
        )"

        [ -n "$FAILED" ] || FAILED=0

        printf '  %-25s ' "Failed neighbors"

        if [ "$FAILED" -gt 0 ] 2>/dev/null; then
            warn "$FAILED FAILED neighbor(s)"
        else
            ok "0"
        fi

    else
        skip "ip utility not installed"
    fi
}

# ================================================================
# PROCESSES
# ================================================================

process_running() {

    PROC="$1"

    if have pgrep; then
        pgrep "$PROC" >/dev/null 2>&1
        return $?
    fi

    ps 2>/dev/null |
        grep -v grep |
        grep -q "$PROC"
}

check_process() {

    PROC="$1"
    REQUIRED="$2"

    if process_running "$PROC"; then

        printf '  %-28s RUNNING\n' "$PROC"

    else

        if [ "$REQUIRED" = "yes" ]; then
            issue "$PROC is not running"
        else
            printf '  %-28s NOT RUNNING\n' "$PROC"
        fi
    fi
}

report_processes() {

    section "SERVICE / PROCESS HEALTH"

    check_process dnsmasq yes
    check_process hostapd yes

    for P in \
        dashboard_controller \
        connkeeper \
        udshape \
        udsplash
    do

        if binary_exists "$P"; then
            check_process "$P" yes
        fi

    done

    for P in anyip juggler; do

        if binary_exists "$P"; then
            check_process "$P" no
        else
            printf '  %-28s NOT PRESENT / N/A\n' "$P"
        fi

    done

    if have ps; then

        ZOMBIES="$(
            ps 2>/dev/null |
            awk '$0 ~ / Z / || $0 ~ /<defunct>/ {c++}
                 END {print c+0}'
        )"

        if [ "$ZOMBIES" -gt 0 ] 2>/dev/null; then
            warn "$ZOMBIES zombie/defunct process(es) detected"
        else
            ok "No zombie processes detected"
        fi
    fi
}

# ================================================================
# LOG ANALYSIS
# ================================================================

get_log() {

    if have logread; then
        logread 2>/dev/null

    elif [ -r /var/log/messages ]; then
        cat /var/log/messages 2>/dev/null
    fi
}

count_log() {

    PATTERN="$1"

    get_log |
        grep -Ei "$PATTERN" |
        wc -l |
        tr -d ' '
}

report_logs() {

    section "LOG / EVENT HEALTH"

    LINK_EVENTS="$(
        count_log 'Link beat lost|link.*(down|lost)|carrier.*down'
    )"

    CHECKIN="$(
        count_log 'dashboard check-in failed|check-in failed|checkin failed'
    )"

    LOOPS="$(
        count_log 'with own address as source address|loop.*detected|network loop'
    )"

    INET="$(
        count_log 'inet_unavailable'
    )"

    RECONFIG="$(
        count_log 'reconfig|re-configure|configuration.*delay|delayed config'
    )"

    OOM="$(
        count_log 'out of memory|oom-killer|killed process'
    )"

    DRIVER="$(
        count_log 'ath10k|ath11k|firmware.*crash|firmware.*failed|watchdog.*reset|radio.*reset'
    )"

    printf '  %-30s %-8s %s\n' "TEST" "COUNT" "STATUS"

    printf '  %-30s %-8s %s\n' \
        "------------------------------" \
        "--------" \
        "----------"

    printf '  %-30s %-8s %s\n' \
        "Link / carrier events" \
        "$LINK_EVENTS" \
        "$([ "$LINK_EVENTS" -gt 0 ] 2>/dev/null && printf WARN || printf OK)"

    printf '  %-30s %-8s %s\n' \
        "Cloud check-in failures" \
        "$CHECKIN" \
        "$([ "$CHECKIN" -gt 0 ] 2>/dev/null && printf WARN || printf OK)"

    printf '  %-30s %-8s %s\n' \
        "Network loop events" \
        "$LOOPS" \
        "$([ "$LOOPS" -gt 0 ] 2>/dev/null && printf WARN || printf OK)"

    printf '  %-30s %-8s %s\n' \
        "inet_unavailable" \
        "$INET" \
        "$([ "$INET" -gt 0 ] 2>/dev/null && printf WARN || printf OK)"

    printf '  %-30s %-8s %s\n' \
        "Reconfiguration events" \
        "$RECONFIG" \
        "$([ "$RECONFIG" -gt 0 ] 2>/dev/null && printf WARN || printf OK)"

    printf '  %-30s %-8s %s\n' \
        "OOM / memory events" \
        "$OOM" \
        "$([ "$OOM" -gt 0 ] 2>/dev/null && printf FAIL || printf OK)"

    printf '  %-30s %-8s %s\n' \
        "Wi-Fi driver/firmware events" \
        "$DRIVER" \
        "$([ "$DRIVER" -gt 0 ] 2>/dev/null && printf WARN || printf OK)"

    [ "$LINK_EVENTS" -gt 0 ] 2>/dev/null &&
        warn "$LINK_EVENTS link/carrier event(s) found"

    [ "$CHECKIN" -gt 0 ] 2>/dev/null &&
        warn "$CHECKIN cloud check-in failure event(s) found"

    [ "$LOOPS" -gt 0 ] 2>/dev/null &&
        warn "$LOOPS possible network loop event(s) found"

    [ "$INET" -gt 0 ] 2>/dev/null &&
        warn "$INET inet_unavailable event(s) found"

    [ "$RECONFIG" -gt 0 ] 2>/dev/null &&
        warn "$RECONFIG reconfiguration event(s) found"

    [ "$OOM" -gt 0 ] 2>/dev/null &&
        issue "$OOM OOM/memory event(s) found"

    [ "$DRIVER" -gt 0 ] 2>/dev/null &&
        warn "$DRIVER Wi-Fi driver/firmware event(s) found"
}

# ================================================================
# WIRELESS DISCOVERY
# ================================================================

get_ap_interfaces() {

    if ! have iw; then
        return
    fi

    iw dev 2>/dev/null |
        awk '
            /^phy#[0-9]+/ {
                PHY=$0
                sub(/^phy#/,"",PHY)
                next
            }

            /^[[:space:]]*Interface / {
                IFACE=$2
                next
            }

            /^[[:space:]]*type AP$/ {
                if(IFACE!="")
                    print PHY "\t" IFACE

                IFACE=""
            }
        '
}

get_channel() {

    IF="$1"

    iw dev "$IF" info 2>/dev/null |
        awk '/channel / {print $2; exit}'
}

get_width() {

    IF="$1"

    iw dev "$IF" info 2>/dev/null |
        awk '
            /channel [0-9]+/ {
                for(i=1;i<=NF;i++)
                    if($i=="width") {
                        print $(i+1)
                        exit
                    }
            }
        '
}

get_txpower() {

    IF="$1"

    iw dev "$IF" info 2>/dev/null |
        awk '/txpower/ {print $2" "$3; exit}'
}

# ================================================================
# RADIO BUSY TIME
# ================================================================

get_busy_from_survey() {

    SURVEY_DATA="$1"

    [ -n "$SURVEY_DATA" ] || return 1

    BUSY_PCT="$(
        printf '%s\n' "$SURVEY_DATA" |
        awk '
            function valid_number(v) {
                return v ~ /^[0-9]+([.][0-9]+)?$/
            }

            /frequency:/ {
                INUSE=($0 ~ /\[in use\]/)
                ACTIVE=""
                BUSY=""
            }

            INUSE && /channel active time:/ {
                ACTIVE=$4
            }

            INUSE && /channel busy time:/ {
                BUSY=$4

                if (valid_number(ACTIVE) &&
                    valid_number(BUSY) &&
                    ACTIVE > 0)
                {
                    PCT=(BUSY*100)/ACTIVE

                    if (PCT > 100)
                        PCT=100

                    printf "%.0f\n",PCT
                    exit
                }
            }
        '
    )"

    if [ -n "$BUSY_PCT" ]; then
        printf '%s\n' "$BUSY_PCT"
        return 0
    fi

    BUSY_PCT="$(
        printf '%s\n' "$SURVEY_DATA" |
        awk '
            function valid_number(v) {
                return v ~ /^[0-9]+([.][0-9]+)?$/
            }

            /frequency:/ {
                ACTIVE=""
                BUSY=""
            }

            /channel active time:/ {
                ACTIVE=$4
            }

            /channel busy time:/ {
                BUSY=$4

                if (valid_number(ACTIVE) &&
                    valid_number(BUSY) &&
                    ACTIVE > 0)
                {
                    PCT=(BUSY*100)/ACTIVE

                    if (PCT > 100)
                        PCT=100

                    printf "%.0f\n",PCT
                    exit
                }
            }
        '
    )"

    if [ -n "$BUSY_PCT" ]; then
        printf '%s\n' "$BUSY_PCT"
        return 0
    fi

    return 1
}

get_busy() {

    IF="$1"
    PHY="$2"

    if [ -n "$IF" ]; then

        SURVEY="$(
            iw dev "$IF" survey dump 2>/dev/null
        )"

        BUSY_RESULT="$(get_busy_from_survey "$SURVEY")"

        if [ -n "$BUSY_RESULT" ]; then
            printf '%s\n' "$BUSY_RESULT"
            return 0
        fi
    fi

    if [ -n "$PHY" ] &&
       [ -d "/sys/class/ieee80211/phy$PHY/device/net" ]
    then

        for NETDEV in /sys/class/ieee80211/phy"$PHY"/device/net/*; do

            [ -e "$NETDEV" ] || continue

            DEV="${NETDEV##*/}"

            [ "$DEV" = "$IF" ] && continue

            SURVEY="$(
                iw dev "$DEV" survey dump 2>/dev/null
            )"

            BUSY_RESULT="$(get_busy_from_survey "$SURVEY")"

            if [ -n "$BUSY_RESULT" ]; then
                printf '%s\n' "$BUSY_RESULT"
                return 0
            fi
        done
    fi

    printf 'N/A\n'
}

get_noise() {

    IF="$1"

    iw dev "$IF" survey dump 2>/dev/null |
        awk '
            /frequency:/ {
                INUSE=($0 ~ /\[in use\]/)
            }

            INUSE && /noise:/ {
                print $2
                exit
            }
        '
}

# ================================================================
# RADIO BUSY TIME
# ================================================================

radio_busy_time() {

    printf '\n'

    section "RADIO BUSY TIME"

    printf '%-10s %-12s %-10s %-10s %-10s %s\n' \
        "PHY" "IF" "CHANNEL" "WIDTH" "BUSY" "STATUS"

    SEEN=""

    get_ap_interfaces |
    while IFS="$(printf '\t')" read -r PHY INT; do

        [ -n "$PHY" ] || continue
        [ -n "$INT" ] || continue

        case " $SEEN " in
            *" $PHY "*)
                continue
                ;;
        esac

        SEEN="$SEEN $PHY"

        CHANNEL="$(get_channel "$INT")"
        WIDTH="$(get_width "$INT")"
        BUSY="$(get_busy "$INT" "$PHY")"

        [ -n "$CHANNEL" ] || CHANNEL="N/A"
        [ -n "$WIDTH" ] || WIDTH="N/A"
        [ -n "$BUSY" ] || BUSY="N/A"

        if [ "$BUSY" = "N/A" ]; then

            STATUS="UNKNOWN"
            COLOR="$C_DIM"

        elif [ "$BUSY" -ge 70 ] 2>/dev/null; then

            STATUS="HIGH"
            COLOR="$C_RED"

        elif [ "$BUSY" -ge 40 ] 2>/dev/null; then

            STATUS="ELEVATED"
            COLOR="$C_YELLOW"

        else

            STATUS="OK"
            COLOR="$C_GREEN"
        fi

        if [ "$BUSY" = "N/A" ]; then
            BUSY_DISPLAY="N/A"
        else
            BUSY_DISPLAY="${BUSY}%"
        fi

        printf '%-10s %-12s %-10s %-10s ' \
            "phy$PHY" \
            "$INT" \
            "$CHANNEL" \
            "$WIDTH"

        printf '%s%-10s%s' \
            "$COLOR" \
            "$BUSY_DISPLAY" \
            "$C_RESET"

        printf '%s%s%s\n' \
            "$COLOR" \
            "$STATUS" \
            "$C_RESET"

    done
}

