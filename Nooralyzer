#!/bin/sh

###############################################################################
#                         NOORALYZER
#              Datto Networking AP Diagnostic Tool
#
# Version: 1.2.0
#
# Designed for Datto Networking / OpenWrt based access points.
###############################################################################

VERSION="1.2.0"

###############################################################################
# COLORS
###############################################################################

C_RESET="$(printf '\033[0m')"
C_BLUE="$(printf '\033[1;34m')"
C_CYAN="$(printf '\033[1;36m')"
C_GREEN="$(printf '\033[1;32m')"
C_YELLOW="$(printf '\033[1;33m')"
C_RED="$(printf '\033[1;31m')"
C_WHITE="$(printf '\033[1;37m')"
C_DIM="$(printf '\033[2m')"

###############################################################################
# GLOBAL COUNTERS
###############################################################################

ISSUES=0
WARNINGS=0
INFO=0

###############################################################################
# STATUS HELPERS
###############################################################################

ok() {
    printf '%b\n' "${C_GREEN}[ OK ]${C_RESET} $*"
}

warn() {
    printf '%b\n' "${C_YELLOW}[ !! ]${C_RESET} $*"
    WARNINGS=$((WARNINGS + 1))
}

fail() {
    printf '%b\n' "${C_RED}[FAIL]${C_RESET} $*"
    ISSUES=$((ISSUES + 1))
}

info() {
    printf '%b\n' "${C_BLUE}[ -- ]${C_RESET} $*"
}

section_header() {
    printf '\n'
    printf '%b\n' "${C_CYAN}+----------------------------------------------------------+${C_RESET}"
    printf '%b\n' "${C_CYAN}| $*${C_RESET}"
    printf '%b\n' "${C_CYAN}+----------------------------------------------------------+${C_RESET}"
}

###############################################################################
# ASCII HEADER
###############################################################################

show_banner() {
    printf '\n'
    printf '%b\n' "${C_CYAN}"
    printf '%s\n' ' _   _  ___   ___  ___    _    _   _    _    _   _  ______  ____  '
    printf '%s\n' '| \ | |/ _ \ / _ \|  _ \  / \  | | | |  / \  | \ | ||  ____|  _ \ '
    printf '%s\n' '|  \| | | | | | | | | | |/ _ \ | | | | / _ \ |  \| || |__  | |_) |'
    printf '%s\n' '| |\  | |_| | |_| | |_| / ___ \| |_| |/ ___ \| |\  ||  __| |  _ < '
    printf '%s\n' '|_| \_|\___/ \___/|____/_/   \_\\___//_/   \_\_| \_||_|    |_| \_\'
    printf '%s\n' ''
    printf '%s\n' '                 Datto Networking AP Diagnostic Tool'
    printf '%s\n' ''
    printf '%s\n' '                    Diagnose . Detect . Troubleshoot'
    printf '%b\n' "${C_RESET}"
    printf '%b\n' "${C_CYAN}NOORALYZER v${VERSION}${C_RESET}"
    printf '\n'
}

###############################################################################
# BASIC COMMAND CHECK
###############################################################################

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

###############################################################################
# SYSTEM INFORMATION
###############################################################################

get_model() {
    if [ -f /tmp/sysinfo/model ]; then
        cat /tmp/sysinfo/model 2>/dev/null
        return
    fi

    if [ -f /tmp/sysinfo/board_name ]; then
        cat /tmp/sysinfo/board_name 2>/dev/null
        return
    fi

    if [ -f /tmp/sysinfo/board_name ]; then
        cat /tmp/sysinfo/board_name 2>/dev/null
        return
    fi

    printf '%s' "Unknown"
}

get_firmware() {
    if [ -f /etc/fw_core_version ]; then
        cat /etc/fw_core_version 2>/dev/null
        return
    fi

    printf '%s' "Unknown"
}

get_memory() {
    awk '
        /MemTotal:/ { total=$2 }
        /MemAvailable:/ { avail=$2 }
        END {
            if (total > 0) {
                used=total-avail
                pct=(used*100)/total
                printf "%dKB / %dKB (%d%% used)", used, total, pct
            } else {
                print "N/A"
            }
        }
    ' /proc/meminfo 2>/dev/null
}

get_overlay() {
    df -k /overlay 2>/dev/null |
        awk 'NR==2 {
            if ($2 > 0)
                printf "%dKB / %dKB (%d%% used)", $3, $2, $5
            else
                print "N/A"
        }'
}

get_conntrack() {
    if [ -r /proc/sys/net/netfilter/nf_conntrack_count ]; then
        current="$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null)"
        max="$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null)"

        if [ -n "$current" ] && [ -n "$max" ]; then
            printf '%s / %s' "$current" "$max"
            return
        fi
    fi

    printf '%s' "N/A"
}

system_health() {
    section_header "SYSTEM HEALTH"

    hostname="$(hostname 2>/dev/null)"
    [ -n "$hostname" ] || hostname="Unknown"

    model="$(get_model)"
    firmware="$(get_firmware)"
    uptime="$(awk '{printf "%.2f hours", $1/3600}' /proc/uptime 2>/dev/null)"
    load="$(cat /proc/loadavg 2>/dev/null | awk '{print $1" "$2" "$3}')"
    memory="$(get_memory)"
    overlay="$(get_overlay)"
    conntrack="$(get_conntrack)"

    printf '  %-24s %s\n' "Hostname" "$hostname"
    printf '  %-24s %s\n' "Model" "$model"
    printf '  %-24s %s\n' "Firmware" "$firmware"
    printf '  %-24s %s\n' "Uptime" "${uptime:-N/A}"
    printf '  %-24s %s\n' "Load" "${load:-N/A}"
    printf '  %-24s %s\n' "Memory" "${memory:-N/A}"
    printf '  %-24s %s\n' "Overlay" "${overlay:-N/A}"
    printf '  %-24s %s\n' "Conntrack" "$conntrack"

    if [ -r /sys/class/thermal/thermal_zone0/temp ]; then
        temp="$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)"

        if [ -n "$temp" ]; then
            temp_c="$(awk -v t="$temp" 'BEGIN {printf "%.1f C", t/1000}')"
            printf '  %-24s %s\n' "CPU Temperature" "$temp_c"
        fi
    else
        printf '  %-24s %s\n' "CPU Temperature" "Not exposed by platform"
    fi
}

###############################################################################
# ETHERNET
###############################################################################

get_speed() {
    iface="$1"

    if [ -f "/sys/class/net/$iface/speed" ]; then
        speed="$(cat "/sys/class/net/$iface/speed" 2>/dev/null)"

        case "$speed" in
            ''|-1|0)
                printf '%s' "N/A"
                ;;
            *)
                printf '%s Mbps' "$speed"
                ;;
        esac
        return
    fi

    printf '%s' "N/A"
}

get_duplex() {
    iface="$1"

    if [ -f "/sys/class/net/$iface/duplex" ]; then
        duplex="$(cat "/sys/class/net/$iface/duplex" 2>/dev/null)"
        [ -n "$duplex" ] && printf '%s' "$duplex" || printf '%s' "N/A"
        return
    fi

    printf '%s' "N/A"
}

get_link() {
    iface="$1"

    if [ -f "/sys/class/net/$iface/operstate" ]; then
        state="$(cat "/sys/class/net/$iface/operstate" 2>/dev/null)"

        case "$state" in
            up)
                printf '%s' "UP"
                ;;
            down)
                printf '%s' "DOWN"
                ;;
            *)
                printf '%s' "N/A"
                ;;
        esac
    else
        printf '%s' "N/A"
    fi
}

get_mac() {
    iface="$1"

    if [ -f "/sys/class/net/$iface/address" ]; then
        cat "/sys/class/net/$iface/address" 2>/dev/null
    else
        printf '%s' "-"
    fi
}

get_ipv4() {
    iface="$1"

    if command_exists ip; then
        ip -4 addr show dev "$iface" 2>/dev/null |
            awk '/inet / {print $2; exit}' |
            cut -d/ -f1
    fi
}

ethernet_health() {
    section_header "UPLINK / ETHERNET"

    printf '%-8s %-7s %-13s %-8s %-18s %-18s\n' \
        "IF" "LINK" "SPEED" "DUPLEX" "MAC" "IPv4"

    printf '%-8s %-7s %-13s %-8s %-18s %-18s\n' \
        "--------" "-------" "-------------" "--------" "------------------" "------------------"

    for iface in eth0 eth1; do
        [ -d "/sys/class/net/$iface" ] || continue

        link="$(get_link "$iface")"
        speed="$(get_speed "$iface")"
        duplex="$(get_duplex "$iface")"
        mac="$(get_mac "$iface")"
        ipv4="$(get_ipv4 "$iface")"

        [ -n "$ipv4" ] || ipv4="-"

        if [ "$link" = "UP" ]; then
            link_display="${C_GREEN}${link}${C_RESET}"
        else
            link_display="${C_YELLOW}${link}${C_RESET}"
        fi

        printf '%-8s %-16b %-13s %-8s %-18s %-18s\n' \
            "$iface" "$link_display" "$speed" "$duplex" "$mac" "$ipv4"
    done
}

###############################################################################
# ETHERNET ERROR COUNTERS
###############################################################################

ethernet_errors() {
    section_header "ETHERNET ERROR COUNTERS"

    printf '%-8s %-8s %-8s %-9s %-9s %-9s %-10s\n' \
        "IF" "RX ERR" "TX ERR" "RX DROP" "TX DROP" "CARRIER" "HEALTH"

    printf '%-8s %-8s %-8s %-9s %-9s %-9s %-10s\n' \
        "--------" "--------" "--------" "---------" "---------" "---------" "----------"

    for iface in eth0 eth1; do
        [ -d "/sys/class/net/$iface" ] || continue

        rxerr="$(cat "/sys/class/net/$iface/statistics/rx_errors" 2>/dev/null)"
        txerr="$(cat "/sys/class/net/$iface/statistics/tx_errors" 2>/dev/null)"
        rxdrop="$(cat "/sys/class/net/$iface/statistics/rx_dropped" 2>/dev/null)"
        txdrop="$(cat "/sys/class/net/$iface/statistics/tx_dropped" 2>/dev/null)"
        carrier="$(cat "/sys/class/net/$iface/statistics/carrier_errors" 2>/dev/null)"

        rxerr="${rxerr:-0}"
        txerr="${txerr:-0}"
        rxdrop="${rxdrop:-0}"
        txdrop="${txdrop:-0}"
        carrier="${carrier:-0}"

        if [ "$rxerr" -gt 0 ] 2>/dev/null ||
           [ "$txerr" -gt 0 ] 2>/dev/null ||
           [ "$carrier" -gt 0 ] 2>/dev/null; then
            health="${C_YELLOW}WARN${C_RESET}"
            WARNINGS=$((WARNINGS + 1))
        else
            health="${C_GREEN}OK${C_RESET}"
        fi

        printf '%-8s %-8s %-8s %-9s %-9s %-9s %b\n' \
            "$iface" "$rxerr" "$txerr" "$rxdrop" "$txdrop" "$carrier" "$health"
    done
}

###############################################################################
# IP INFORMATION
###############################################################################

ip_map() {
    section_header "INTERFACE / IP MAP"

    printf '%-18s %-20s %-18s\n' \
        "INTERFACE" "MAC" "IPv4"

    printf '%-18s %-20s %-18s\n' \
        "------------------" "--------------------" "------------------"

    if command_exists ip; then
        ip -o link show 2>/dev/null |
        while read -r num name rest; do
            iface="$(printf '%s' "$name" | sed 's/@.*//')"

            case "$iface" in
                lo|eth0|eth1|br-*|bat*|wlan*|ap*)
                    mac="$(get_mac "$iface")"
                    ipv4="$(get_ipv4 "$iface")"

                    [ -n "$ipv4" ] || ipv4="-"

                    printf '%-18s %-20s %-18s\n' \
                        "$iface" "$mac" "$ipv4"
                    ;;
            esac
        done
    fi
}

###############################################################################
# CONNECTIVITY HEALTH
###############################################################################

get_default_gateway() {
    if command_exists ip; then
        ip route 2>/dev/null |
            awk '$1=="default" {print $3; exit}'
    fi
}

connectivity_health() {
    section_header "CONNECTIVITY HEALTH"

    gateway="$(get_default_gateway)"

    if [ -n "$gateway" ]; then
        ok "Default gateway: $gateway"

        if command_exists ping; then
            if ping -c 1 -W 2 "$gateway" >/dev/null 2>&1; then
                ok "Gateway reachability"
            else
                fail "Gateway is not reachable"
            fi
        else
            info "Gateway test unavailable"
        fi
    else
        warn "No default gateway exposed"
    fi

    if command_exists ping; then
        if ping -c 2 -W 3 1.1.1.1 >/dev/null 2>&1; then
            ok "Internet 1.1.1.1 reachable"
        else
            warn "Internet 1.1.1.1 unreachable"
        fi
    else
        info "Internet ping test unavailable"
    fi

    if [ -f /etc/resolv.conf ]; then
        dns_server="$(awk '/^nameserver/ {print $2; exit}' /etc/resolv.conf)"

        if [ -n "$dns_server" ]; then
            ok "DNS server: $dns_server"
        else
            warn "No DNS server configured"
        fi
    else
        warn "DNS configuration not found"
    fi

    if command_exists nslookup; then
        if nslookup cloudflare.com >/dev/null 2>&1; then
            ok "DNS resolution"
        else
            warn "DNS resolution failed"
        fi
    elif command_exists ping; then
        if ping -c 1 -W 3 cloudflare.com >/dev/null 2>&1; then
            ok "DNS resolution"
        else
            warn "DNS resolution failed"
        fi
    else
        info "DNS resolution test unavailable"
    fi

    if command_exists wget; then
        if wget -q -T 5 -O /dev/null https://cloudflare.com >/dev/null 2>&1; then
            ok "HTTPS connectivity"
        else
            warn "HTTPS connectivity failed"
        fi
    elif command_exists curl; then
        if curl -k -s --connect-timeout 5 -o /dev/null https://cloudflare.com >/dev/null 2>&1; then
            ok "HTTPS connectivity"
        else
            warn "HTTPS connectivity failed"
        fi
    else
        info "HTTPS test unavailable"
    fi
}

###############################################################################
# NETWORK STATE
###############################################################################

network_state() {
    section_header "NETWORK STATE"

    if command_exists ip; then
        default_route="$(ip route 2>/dev/null | awk '$1=="default" {print; exit}')"

        if [ -n "$default_route" ]; then
            ok "Default route present"
        else
            warn "No default route exposed"
        fi

        route_count="$(ip -4 route 2>/dev/null | wc -l | tr -d ' ')"
        route_count="${route_count:-0}"

        ok "IPv4 routes: $route_count"

        failed_neighbors="$(ip neigh 2>/dev/null |
            awk '$NF=="FAILED" {count++} END {print count+0}')"

        if [ "$failed_neighbors" -gt 0 ] 2>/dev/null; then
            warn "$failed_neighbors failed neighbor(s)"
        else
            ok "No failed neighbors"
        fi
    else
        info "ip command unavailable"
    fi
}

###############################################################################
# MANAGEMENT CONNECTIVITY
###############################################################################

management_connectivity() {
    section_header "MANAGEMENT CONNECTIVITY"

    management_ip=""

    for iface in br-wired0 br-wired1 br-mesh_gw br-lan eth0 eth1; do
        [ -d "/sys/class/net/$iface" ] || continue

        ipaddr="$(get_ipv4 "$iface")"

        if [ -n "$ipaddr" ]; then
            management_ip="$ipaddr"
            break
        fi
    done

    if [ -n "$management_ip" ]; then
        ok "Management IP: $management_ip"
    else
        warn "No IPv4 management address found"
    fi
}

###############################################################################
# DHCP / BRIDGE HEALTH
###############################################################################

dhcp_bridge_health() {
    section_header "DHCP / BRIDGE HEALTH"

    if command_exists pgrep; then
        if pgrep dnsmasq >/dev/null 2>&1; then
            ok "dnsmasq is running"
        else
            warn "dnsmasq is not running"
        fi
    else
        if ps 2>/dev/null | grep '[d]nsmasq' >/dev/null 2>&1; then
            ok "dnsmasq is running"
        else
            warn "dnsmasq is not running"
        fi
    fi

    if command_exists brctl; then
        bridges="$(brctl show 2>/dev/null | awk 'NR>1 {print $1}' | tr '\n' ' ')"
    elif [ -d /sys/class/net ]; then
        bridges="$(for b in /sys/class/net/br-*; do
            [ -e "$b" ] && basename "$b"
        done | tr '\n' ' ')"
    else
        bridges=""
    fi

    if [ -n "$bridges" ]; then
        ok "Bridges: $bridges"
    else
        info "Bridge information unavailable"
    fi
}

###############################################################################
# PROCESS HEALTH
###############################################################################

process_running() {
    proc="$1"

    if command_exists pgrep; then
        if pgrep "$proc" >/dev/null 2>&1; then
            printf '%s' "RUNNING"
        else
            printf '%s' "NOT PRESENT / N/A"
        fi
    else
        if ps 2>/dev/null | grep "[${proc%?}]${proc#?}" >/dev/null 2>&1; then
            printf '%s' "RUNNING"
        else
            printf '%s' "NOT PRESENT / N/A"
        fi
    fi
}

process_health() {
    section_header "SERVICE / PROCESS HEALTH"

    for proc in dnsmasq hostapd udshape udsplash anyip juggler; do
        state="$(process_running "$proc")"

        case "$state" in
            RUNNING)
                printf '  %-24s %b\n' "$proc" "${C_GREEN}${state}${C_RESET}"
                ;;
            *)
                printf '  %-24s %b\n' "$proc" "${C_YELLOW}${state}${C_RESET}"
                ;;
        esac
    done

    zombies="$(ps 2>/dev/null |
        awk 'NR>1 && $0 ~ / Z / {count++} END {print count+0}')"

    if [ "$zombies" -gt 0 ] 2>/dev/null; then
        warn "$zombies zombie/defunct process(es) detected"
    else
        ok "No zombie/defunct processes detected"
    fi
}

###############################################################################
# LOG / EVENT HEALTH
###############################################################################

log_count() {
    pattern="$1"

    if ! command_exists logread; then
        printf '%s' "N/A"
        return
    fi

    logread 2>/dev/null |
        grep -i "$pattern" 2>/dev/null |
        wc -l |
        tr -d ' '
}

log_event_health() {
    section_header "LOG / EVENT HEALTH"

    printf '%-29s %-9s %-10s\n' \
        "TEST" "COUNT" "STATUS"

    printf '%-29s %-9s %-10s\n' \
        "-----------------------------" "---------" "----------"

    tests="
Link / carrier events|link.*(beat|carrier)|WARN
Cloud check-in failures|check.?in.*fail|OK
Network loop events|loop|OK
inet_unavailable|inet_unavailable|OK
Reconfiguration events|reconfig|OK
OOM / memory events|out of memory|OK
Wi-Fi driver/firmware events|ath10k|WARN
"

    oldIFS="$IFS"
    IFS='
'

    for line in $tests; do
        name="$(printf '%s' "$line" | cut -d'|' -f1)"
        pattern="$(printf '%s' "$line" | cut -d'|' -f2)"
        expected="$(printf '%s' "$line" | cut -d'|' -f3)"

        count="$(log_count "$pattern")"

        if [ "$count" = "N/A" ]; then
            status="${C_BLUE}N/A${C_RESET}"
        elif [ "$count" -gt 0 ] 2>/dev/null; then
            status="${C_YELLOW}WARN${C_RESET}"
            WARNINGS=$((WARNINGS + 1))
        else
            status="${C_GREEN}OK${C_RESET}"
        fi

        printf '%-29s %-9s %b\n' "$name" "$count" "$status"
    done

    IFS="$oldIFS"
}

###############################################################################
# RADIO HELPERS
###############################################################################

get_phy_for_interface() {
    iface="$1"

    if [ -L "/sys/class/net/$iface/phy80211" ]; then
        basename "$(readlink "/sys/class/net/$iface/phy80211" 2>/dev/null)"
        return
    fi

    if [ -L "/sys/class/net/$iface/phy80211" ]; then
        readlink "/sys/class/net/$iface/phy80211" 2>/dev/null
    fi
}

get_radio_interface() {
    phy="$1"

    for iface_path in /sys/class/net/*; do
        [ -e "$iface_path" ] || continue

        iface="$(basename "$iface_path")"

        [ -L "$iface_path/phy80211" ] || continue

        mapped="$(basename "$(readlink "$iface_path/phy80211" 2>/dev/null)")"

        if [ "$mapped" = "$phy" ]; then
            printf '%s' "$iface"
            return
        fi
    done

    printf '%s' ""
}

get_channel() {
    iface="$1"

    if ! command_exists iw; then
        printf '%s' "N/A"
        return
    fi

    iw dev "$iface" info 2>/dev/null |
        awk '/channel/ {
            print $2
            exit
        }'
}

get_width() {
    iface="$1"

    if ! command_exists iw; then
        printf '%s' "N/A"
        return
    fi

    width="$(iw dev "$iface" info 2>/dev/null |
        awk '
            /width:/ {
                for (i=1; i<=NF; i++) {
                    if ($i == "width:") {
                        print $(i+1)
                        exit
                    }
                }
            }
        ')"

    [ -n "$width" ] || width="N/A"

    printf '%s' "$width"
}

###############################################################################
# WIRELESS RADIO HEALTH
###############################################################################

wireless_radio_health() {
    section_header "WIRELESS RADIO HEALTH"

    if ! command_exists iw; then
        info "iw command unavailable"
        return
    fi

    printf '%-8s %-12s %-9s %-9s %-8s %-10s %-10s\n' \
        "PHY" "IF" "CHANNEL" "WIDTH" "BUSY" "NOISE" "TX POWER"

    printf '%-8s %-12s %-9s %-9s %-8s %-10s %-10s\n' \
        "--------" "------------" "---------" "---------" "--------" "----------" "----------"

    iw dev 2>/dev/null |
    awk '
        $1=="Interface" {
            iface=$2
        }
        $1=="wiphy" {
            phy="phy"$2
        }
        $1=="channel" {
            channel=$2
            printf "%s|%s|%s\n", phy, iface, channel
        }
    ' |
    while IFS='|' read -r phy iface channel; do
        [ -n "$iface" ] || continue

        width="$(get_width "$iface")"

        survey="$(iw dev "$iface" survey dump 2>/dev/null)"

        busy_pct="$(printf '%s\n' "$survey" |
            awk -F': ' '
                /channel active time/ {
                    active += $2
                }
                /channel busy time/ {
                    busy += $2
                }
                END {
                    if (active > 0)
                        printf "%.0f", (busy / active) * 100
                    else
                        printf "N/A"
                }
            ')"

        noise="$(printf '%s\n' "$survey" |
            awk -F': ' '/noise:/ {print $2; exit}')"

        txpower="$(iw dev "$iface" info 2>/dev/null |
            awk '/txpower/ {print $2" "$3; exit}')"

        [ -n "$noise" ] || noise="N/A"
        [ -n "$txpower" ] || txpower="N/A"

        if [ "$busy_pct" = "N/A" ]; then
            busy_display="N/A"
            health="${C_YELLOW}UNKNOWN${C_RESET}"
        elif [ "$busy_pct" -ge 80 ] 2>/dev/null; then
            busy_display="${busy_pct}%"
            health="${C_RED}HIGH${C_RESET}"
        elif [ "$busy_pct" -ge 50 ] 2>/dev/null; then
            busy_display="${busy_pct}%"
            health="${C_YELLOW}ELEVATED${C_RESET}"
        else
            busy_display="${busy_pct}%"
            health="${C_GREEN}OK${C_RESET}"
        fi

        printf '%-8s %-12s %-9s %-9s %-8s %-10s %-10s %b\n' \
            "$phy" \
            "$iface" \
            "$channel" \
            "$width" \
            "$busy_display" \
            "$noise" \
            "$txpower" \
            "$health"
    done
}

###############################################################################
# RADIO BUSY TIME
###############################################################################

radio_busy_time() {
    section_header "RADIO BUSY TIME"

    if ! command_exists iw; then
        info "iw command unavailable"
        return
    fi

    printf '%-8s %-12s %-9s %-9s %-8s %-10s\n' \
        "PHY" "IF" "CHANNEL" "WIDTH" "BUSY" "STATUS"

    printf '%-8s %-12s %-9s %-9s %-8s %-10s\n' \
        "--------" "------------" "---------" "---------" "--------" "----------"

    found=0

    iw dev 2>/dev/null |
    awk '
        $1=="Interface" {
            iface=$2
        }
        $1=="wiphy" {
            phy="phy"$2
        }
        $1=="channel" {
            channel=$2
            printf "%s|%s|%s\n", phy, iface, channel
        }
    ' |
    while IFS='|' read -r phy iface channel; do
        [ -n "$iface" ] || continue

        found=1

        width="$(get_width "$iface")"

        active=0
        busy=0

        survey="$(iw dev "$iface" survey dump 2>/dev/null)"

        active="$(printf '%s\n' "$survey" |
            awk -F': ' '
                /channel active time/ {
                    total += $2
                }
                END {
                    print total+0
                }
            ')"

        busy="$(printf '%s\n' "$survey" |
            awk -F': ' '
                /channel busy time/ {
                    total += $2
                }
                END {
                    print total+0
                }
            ')"

        if [ "${active:-0}" -gt 0 ] 2>/dev/null; then

            busy_pct="$(awk \
                -v busy="$busy" \
                -v active="$active" \
                'BEGIN {
                    if (active > 0)
                        printf "%.0f", (busy / active) * 100
                    else
                        printf "0"
                }')"

            if [ "$busy_pct" -ge 80 ] 2>/dev/null; then
                status="${C_RED}HIGH${C_RESET}"
            elif [ "$busy_pct" -ge 50 ] 2>/dev/null; then
                status="${C_YELLOW}ELEVATED${C_RESET}"
            else
                status="${C_GREEN}OK${C_RESET}"
            fi

            busy_display="${busy_pct}%"

        else
            busy_display="N/A"
            status="${C_YELLOW}UNKNOWN${C_RESET}"
        fi

        printf '%-8s %-12s %-9s %-9s %-8s %b\n' \
            "$phy" \
            "$iface" \
            "$channel" \
            "$width" \
            "$busy_display" \
            "$status"
    done

    printf '\n'
}

###############################################################################
# WI-FI CLIENT HEALTH
###############################################################################

get_client_count() {
    iface="$1"

    if ! command_exists iw; then
        printf '%s' "N/A"
        return
    fi

    iw dev "$iface" station dump 2>/dev/null |
        awk '/^Station / {count++} END {print count+0}'
}

wifi_clients() {
    section_header "WI-FI CLIENT HEALTH"

    if ! command_exists iw; then
        info "iw command unavailable"
        return
    fi

    total=0

    printf '  %-18s %-8s\n' "INTERFACE" "CLIENTS"
    printf '  %-18s %-8s\n' "------------------" "--------"

    iw dev 2>/dev/null |
    awk '$1=="Interface" {print $2}' |
    while read -r iface; do
        [ -n "$iface" ] || continue

        count="$(get_client_count "$iface")"
        count="${count:-0}"

        total=$((total + count))

        printf '  %-18s %-8s\n' "$iface" "$count"
    done

    printf '\n'

    printf '  %-12s %-20s %-8s %-15s %-15s %-10s\n' \
        "IF" "CLIENT MAC" "RSSI" "TX RATE" "INACTIVE" "RETRIES"

    printf '  %-12s %-20s %-8s %-15s %-15s %-10s\n' \
        "------------" "--------------------" "--------" "---------------" "---------------" "----------"

    client_total=0

    iw dev 2>/dev/null |
    awk '$1=="Interface" {print $2}' |
    while read -r iface; do
        [ -n "$iface" ] || continue

        iw dev "$iface" station dump 2>/dev/null |
        awk -v iface="$iface" '
            /^Station / {
                mac=$2
            }

            /signal:/ {
                signal=$2
            }

            /tx bitrate:/ {
                tx=$3" "$4
            }

            /inactive time:/ {
                inactive=$3" "$4
            }

            /tx retries:/ {
                retries=$3

                printf "  %-12s %-20s %-8s %-15s %-15s %-10s\n",
                    iface, mac, signal, tx, inactive, retries
            }
        '
    done

    printf '\n'

    # Recalculate total directly rather than relying on subshell variables.
    client_total="$(iw dev 2>/dev/null |
        awk '$1=="Interface" {print $2}' |
        while read -r iface; do
            get_client_count "$iface"
        done |
        awk '{sum += $1} END {print sum+0}')"

    printf '  Total clients: %s\n' "${client_total:-0}"
}

###############################################################################
# AP STATE
###############################################################################

ap_state() {
    section_header "AP STATE"

    if command_exists iw; then
        ok "Dependency: iw"
    else
        warn "Dependency: iw unavailable"
    fi

    if command_exists pgrep; then
        ok "Dependency: pgrep"
    else
        info "Dependency: pgrep unavailable"
    fi

    if command_exists logread; then
        ok "Dependency: logread"
    else
        info "Dependency: logread unavailable"
    fi

    phy_count="$(iw dev 2>/dev/null |
        awk '$1=="wiphy" {count++} END {print count+0}')"

    if [ "$phy_count" -gt 0 ] 2>/dev/null; then
        ok "Wireless PHYs: $phy_count detected"
    else
        warn "No wireless PHYs detected"
    fi

    gateway="$(get_default_gateway)"

    if [ -n "$gateway" ]; then
        ok "Default route: $gateway"
    else
        warn "Default route: MISSING"
    fi

    dns_server="$(awk '/^nameserver/ {print $2; exit}' /etc/resolv.conf 2>/dev/null)"

    if [ -n "$dns_server" ]; then
        ok "DNS configuration: Present"
    else
        warn "DNS configuration: MISSING"
    fi
}

###############################################################################
# RADIO INTERFACE TEST
###############################################################################

radio_interface_check() {
    section_header "RADIO INTERFACE CHECK"

    if ! command_exists iw; then
        info "iw command unavailable"
        return
    fi

    iw dev 2>/dev/null |
    awk '
        $1=="Interface" {
            iface=$2
        }

        $1=="type" {
            printf "%-18s %-12s\n", iface, $2
        }
    '
}

###############################################################################
# DNS CONFIGURATION TEST
###############################################################################

dns_configuration_test() {
    section_header "DNS CONFIGURATION"

    if [ ! -f /etc/resolv.conf ]; then
        fail "/etc/resolv.conf does not exist"
        return
    fi

    servers="$(awk '/^nameserver/ {print $2}' /etc/resolv.conf)"

    if [ -n "$servers" ]; then
        ok "Configured DNS server(s):"
        printf '%s\n' "$servers" |
        while read -r server; do
            printf '      %s\n' "$server"
        done
    else
        warn "No nameserver entries found"
    fi
}

###############################################################################
# ARP / NEIGHBOR HEALTH
###############################################################################

neighbor_health() {
    section_header "NEIGHBOR / ARP HEALTH"

    if ! command_exists ip; then
        info "ip command unavailable"
        return
    fi

    failed="$(ip neigh 2>/dev/null |
        awk '$NF=="FAILED" {count++} END {print count+0}')"

    stale="$(ip neigh 2>/dev/null |
        awk '$NF=="STALE" {count++} END {print count+0}')"

    reachable="$(ip neigh 2>/dev/null |
        awk '$NF=="REACHABLE" {count++} END {print count+0}')"

    if [ "$failed" -gt 0 ] 2>/dev/null; then
        warn "$failed failed neighbor(s)"
    else
        ok "Failed neighbors: 0"
    fi

    printf '  Reachable: %s\n' "${reachable:-0}"
    printf '  Stale:     %s\n' "${stale:-0}"
}

###############################################################################
# NOORALYZER VERDICT
###############################################################################

verdict() {
    section_header "NOORALYZER VERDICT"

    printf '  %-20s %s\n' "Issues" "$ISSUES"
    printf '  %-20s %s\n' "Warnings" "$WARNINGS"
    printf '  %-20s %s\n' "Informational" "$INFO"

    printf '\n'

    if [ "$ISSUES" -gt 0 ]; then
        printf '%b\n' "${C_RED}+----------------------------------------------------------+${C_RESET}"
        printf '%b\n' "${C_RED}|                 HEALTH: ACTION REQUIRED                 |${C_RESET}"
        printf '%b\n' "${C_RED}+----------------------------------------------------------+${C_RESET}"
    elif [ "$WARNINGS" -gt 0 ]; then
        printf '%b\n' "${C_YELLOW}+----------------------------------------------------------+${C_RESET}"
        printf '%b\n' "${C_YELLOW}|                    HEALTH: REVIEW                       |${C_RESET}"
        printf '%b\n' "${C_YELLOW}+----------------------------------------------------------+${C_RESET}"
    else
        printf '%b\n' "${C_GREEN}+----------------------------------------------------------+${C_RESET}"
        printf '%b\n' "${C_GREEN}|                    HEALTH: GOOD                         |${C_RESET}"
        printf '%b\n' "${C_GREEN}+----------------------------------------------------------+${C_RESET}"
    fi

    printf '\n'
    printf '%b\n' "${C_BLUE}[ -- ] means the test/capability is not available."
    printf '%b\n' "${C_BLUE}[ -- ] does NOT count as a failure.${C_RESET}"
}

###############################################################################
# COMPLETE
###############################################################################

complete_message() {
    printf '\n'
    printf '%b\n' "${C_CYAN}+----------------------------------------------------------+${C_RESET}"
    printf '%b\n' "${C_CYAN}|                  NOORALYZER COMPLETE                    |${C_RESET}"
    printf '%b\n' "${C_CYAN}+----------------------------------------------------------+${C_RESET}"
    printf '\n'
}

