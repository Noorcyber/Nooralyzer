get_ssid() {

    IF="$1"

    iw dev "$IF" info 2>/dev/null |
        awk -F': ' '/ssid / {print $2; exit}'
}

get_bssid() {

    IF="$1"

    iw dev "$IF" info 2>/dev/null |
        awk '/addr / {print $2; exit}'
}

get_ssid_clients() {

    IF="$1"

    count_clients "$IF"
}

report_ssid_interfaces() {

    section_wide "SSID INTERFACES"

    printf '  %-7s %-9s %-18s %-8s %-6s %-4s %-7s %-9s %-7s %-35s\n' \
        "SSID" "IF" "BSSID" "Clients" "Band" "Ch" "Width" "Tx" "Phy" "ESSID"

    printf '  %-7s %-9s %-18s %-8s %-6s %-4s %-7s %-9s %-7s %-35s\n' \
        "-------" "---------" "------------------" "--------" \
        "------" "----" "-------" "---------" "-------" \
        "-----------------------------------"

    if ! have iw; then
        skip "iw is not installed"
        return
    fi

    SSID_FILE="${TMP_BASE}_ssid"

    get_ap_interfaces > "$SSID_FILE" 2>/dev/null

    if [ ! -s "$SSID_FILE" ]; then
        skip "No AP-mode wireless interfaces detected"
        return
    fi

    TOTAL_CLIENTS=0
    TOTAL_ROWS=0

    while IFS="$(printf '\t')" read -r PHY INT; do

        [ -n "$INT" ] || continue

        SSID="$(get_ssid "$INT")"
        BSSID="$(get_bssid "$INT")"
        CHANNEL="$(get_channel "$INT")"
        WIDTH="$(get_width "$INT")"
        TXPOWER="$(get_txpower "$INT")"
        CLIENTS="$(get_ssid_clients "$INT")"
        BAND="$(get_band "$CHANNEL")"

        [ -n "$SSID" ] || SSID="N/A"
        [ -n "$BSSID" ] || BSSID="N/A"
        [ -n "$CHANNEL" ] || CHANNEL="N/A"
        [ -n "$WIDTH" ] || WIDTH="N/A"
        [ -n "$TXPOWER" ] || TXPOWER="N/A"
        [ -n "$CLIENTS" ] || CLIENTS=0
        [ -n "$BAND" ] || BAND="N/A"

        # Width returned by iw can include "MHz".
        WIDTH_DISPLAY="$WIDTH"
        case "$WIDTH_DISPLAY" in
            *MHz)
                WIDTH_DISPLAY="${WIDTH_DISPLAY%MHz}"
                ;;
        esac

        # Tx power normally comes back as "19.00 dBm".
        TX_DISPLAY="$TXPOWER"
        TX_DISPLAY="${TX_DISPLAY% dBm}"

        # Create a simple SSID number based on the VAP suffix.
        case "$INT" in
            *_1) SSID_NAME="SSID1" ;;
            *_2) SSID_NAME="SSID2" ;;
            *_3) SSID_NAME="SSID3" ;;
            *_4) SSID_NAME="SSID4" ;;
            *) SSID_NAME="SSID" ;;
        esac

        TOTAL_CLIENTS=$((TOTAL_CLIENTS + CLIENTS))
        TOTAL_ROWS=$((TOTAL_ROWS + 1))

        printf '  %-7s %-9s %-18s %-8s %-6s %-4s %-7s %-9s %-7s %-35s\n' \
            "$SSID_NAME" \
            "$INT" \
            "$BSSID" \
            "$CLIENTS" \
            "$BAND" \
            "$CHANNEL" \
            "$WIDTH_DISPLAY" \
            "$TX_DISPLAY" \
            "phy$PHY" \
            "$SSID"

    done < "$SSID_FILE"

    printf '  %-7s %-9s %-18s %-8s %-6s %-4s %-7s %-9s %-7s %-35s\n' \
        "-------" "---------" "------------------" "--------" \
        "------" "----" "-------" "---------" "-------" \
        "-----------------------------------"

    printf '  %-7s %-9s %-18s %-8s %-6s %-4s %-7s %-9s %-7s %-35s\n' \
        "Total" "---" "---" "$TOTAL_CLIENTS" \
        "---" "---" "---" "---" "---" "---"
}

# ================================================================
# CLIENTS
# ================================================================

count_clients() {

    IF="$1"

    iw "$IF" station dump 2>/dev/null |
        awk '/^Station / {C++} END {print C+0}'
}

report_client_details() {

    IF="$1"

    iw "$IF" station dump 2>/dev/null |
        awk -v IFACE="$IF" '

            function emit() {

                if(MAC!="")
                    printf \
                        "  %-10s %-20s %-8s %-18s %-12s %-8s\n",
                        IFACE,
                        MAC,
                        SIGNAL,
                        TX,
                        INACTIVE,
                        RETRIES
            }

            /^Station / {

                emit()

                MAC=$2
                SIGNAL="N/A"
                TX="N/A"
                INACTIVE="N/A"
                RETRIES="N/A"

                next
            }

            /^[[:space:]]*signal:/ {

                SIGNAL=$2" "$3

                next
            }

            /^[[:space:]]*tx bitrate:/ {

                TX=$3" "$4

                next
            }

            /^[[:space:]]*inactive time:/ {

                INACTIVE=$3" "$4

                next
            }

            /^[[:space:]]*tx retries:/ {

                RETRIES=$3

                next
            }

            END {
                emit()
            }
        '
}

report_clients() {

    section "WI-FI CLIENT HEALTH"

    if ! have iw; then
        skip "iw is not installed"
        return
    fi

    CLIENT_FILE="${TMP_BASE}_clients"

    get_ap_interfaces > "$CLIENT_FILE" 2>/dev/null

    if [ ! -s "$CLIENT_FILE" ]; then
        skip "No AP-mode wireless interfaces detected"
        return
    fi

    printf '  %-18s %s\n' "INTERFACE" "CLIENTS"

    printf '  %-18s %s\n' \
        "------------------" \
        "-------"

    TOTAL=0

    while IFS="$(printf '\t')" read -r PHY INT; do

        [ -n "$INT" ] || continue

        COUNT="$(count_clients "$INT")"

        [ -n "$COUNT" ] || COUNT=0

        TOTAL=$((TOTAL + COUNT))

        printf '  %-18s %s\n' \
            "$INT" \
            "$COUNT"

    done < "$CLIENT_FILE"

    printf '\n  Total clients: %s\n\n' "$TOTAL"

    if [ "$TOTAL" -gt 0 ] 2>/dev/null; then

        printf '  %-10s %-20s %-8s %-18s %-12s %-8s\n' \
            "IF" \
            "CLIENT MAC" \
            "RSSI" \
            "TX RATE" \
            "INACTIVE" \
            "RETRIES"

        printf '  %-10s %-20s %-8s %-18s %-12s %-8s\n' \
            "----------" \
            "--------------------" \
            "--------" \
            "------------------" \
            "------------" \
            "--------"

        while IFS="$(printf '\t')" read -r PHY INT; do

            [ -n "$INT" ] || continue

            report_client_details "$INT"

        done < "$CLIENT_FILE"
    fi
}

# ================================================================
# MANAGEMENT
# ================================================================

report_management() {

    section "MANAGEMENT CONNECTIVITY"

    MANAGEMENT_IP=""
    MANAGEMENT_INT=""

    for D in /sys/class/net/*; do

        [ -e "$D" ] || continue

        INT="${D##*/}"

        case "$INT" in
            lo|bat*|br-*|erspan*|ifb*|miireg|teql*|survey|wlan*)
                continue
                ;;
        esac

        ADDR="$(get_ipv4 "$INT")"

        case "$ADDR" in
            ""|127.*)
                continue
                ;;
        esac

        MANAGEMENT_IP="$ADDR"
        MANAGEMENT_INT="$INT"

        break
    done

    printf '  %-25s ' "Management IP"

    if [ -n "$MANAGEMENT_IP" ]; then
        ok "$MANAGEMENT_IP ($MANAGEMENT_INT)"
    else
        warn "No IPv4 management address found"
    fi
}

# ================================================================
# DHCP / BRIDGES
# ================================================================

report_dhcp_bridge() {

    section "DHCP / BRIDGE HEALTH"

    if binary_exists dnsmasq; then

        if process_running dnsmasq; then
            ok "dnsmasq is running"
        else
            info "dnsmasq installed but not running"
        fi

    else
        skip "dnsmasq not installed / not applicable"
    fi

    if have brctl; then

        BRIDGES="$(
            brctl show 2>/dev/null |
            awk 'NR>1 && $1!="" {print $1}' |
            sort -u |
            tr '\n' ' ' |
            sed 's/[[:space:]]*$//'
        )"

        if [ -n "$BRIDGES" ]; then

            # Keep long bridge lists inside the 70-character box.
            printf '%s\n' "$BRIDGES" |
            awk '
                {
                    line=$0

                    while (length(line) > 62) {
                        cut=62

                        while (cut > 1 && substr(line,cut,1)!=" ")
                            cut--

                        if (cut <= 1)
                            cut=62

                        printf "[ OK ] Bridges: %s\n", substr(line,1,cut-1)

                        line=substr(line,cut+1)
                    }

                    if (length(line) > 0)
                        printf "[ OK ] Bridges: %s\n", line
                }
            ' |
            while IFS= read -r LINE; do
                printf '  %s\n' "$LINE"
            done

        else
            info "No bridge information returned"
        fi

    elif [ -d /sys/class/net ]; then

        BRIDGE_COUNT="$(
            find /sys/class/net \
                -maxdepth 2 \
                -type l \
                -path '*/bridge' \
                2>/dev/null |
            wc -l |
            tr -d ' '
        )"

        if [ "${BRIDGE_COUNT:-0}" -gt 0 ] 2>/dev/null; then
            ok "$BRIDGE_COUNT bridge interface(s) detected"
        else
            info "Bridge details not exposed"
        fi

    else
        skip "Bridge information unavailable"
    fi
}

