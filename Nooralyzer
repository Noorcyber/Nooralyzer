# ================================================================
# DHCP / BRIDGES
# ================================================================

report_dhcp_bridge() {

    section "DHCP / BRIDGE HEALTH"

    if binary_exists dnsmasq; then

        if process_running dnsmasq; then
            ok "dnsmasq is running"
        else
            info "dnsmasq installed but not running"
        fi

    else
        skip "dnsmasq not installed / not applicable"
    fi

    if have brctl; then

        BRIDGES="$(
            brctl show 2>/dev/null |
            awk 'NR>1 && $1!="" {print $1}' |
            sort -u |
            tr '\n' ' ' |
            sed 's/[[:space:]]*$//'
        )"

        if [ -n "$BRIDGES" ]; then

            # Keep long bridge lists inside the 70-character box.
            printf '%s\n' "$BRIDGES" |
            awk '
                {
                    line=$0

                    while (length(line) > 62) {
                        cut=62

                        while (cut > 1 && substr(line,cut,1)!=" ")
                            cut--

                        if (cut <= 1)
                            cut=62

                        printf "[ OK ] Bridges: %s\n", substr(line,1,cut-1)

                        line=substr(line,cut+1)
                    }

                    if (length(line) > 0)
                        printf "[ OK ] Bridges: %s\n", line
                }
            ' |
            while IFS= read -r LINE; do
                printf '  %s\n' "$LINE"
            done

        else
            info "No bridge information returned"
        fi

    elif [ -d /sys/class/net ]; then

        BRIDGE_COUNT="$(
            find /sys/class/net \
                -maxdepth 2 \
                -type l \
                -path '*/bridge' \
                2>/dev/null |
            wc -l |
            tr -d ' '
        )"

        if [ "${BRIDGE_COUNT:-0}" -gt 0 ] 2>/dev/null; then
            ok "$BRIDGE_COUNT bridge interface(s) detected"
        else
            info "Bridge details not exposed"
        fi

    else
        skip "Bridge information unavailable"
    fi
}

# ================================================================
# ETHERNET LINK STABILITY
#
# Uses the kernel carrier event counter for physical Ethernet
# interfaces. This is a counter of carrier changes reported by the
# interface; it is NOT treated as proof of a bad cable by itself.
# ================================================================

report_link_stability() {

    section "ETHERNET LINK STABILITY"

    printf '  %-8s %-16s %s\n' "IF" "CARRIER EVENTS" "STATUS"
    printf '  %-8s %-16s %s\n' "--------" "----------------" "----------"

    FOUND=0

    for D in /sys/class/net/*; do
        [ -e "$D" ] || continue
        INT="${D##*/}"
        is_physical_ethernet "$INT" || continue
        FOUND=1

        CARRIER="$(stat_value "$INT" carrier)"
        [ -n "$CARRIER" ] || CARRIER=0

        if [ "$CARRIER" -ge 20 ] 2>/dev/null; then
            STATUS="HIGH"
            COLOR="$C_RED"
        elif [ "$CARRIER" -gt 0 ] 2>/dev/null; then
            STATUS="REVIEW"
            COLOR="$C_YELLOW"
        else
            STATUS="OK"
            COLOR="$C_GREEN"
        fi

        printf '  %-8s %-16s ' "$INT" "$CARRIER"
        printf '%s%s%s\n' "$COLOR" "$STATUS" "$C_RESET"
    done

    [ "$FOUND" -eq 1 ] || skip "No physical Ethernet interfaces detected"
}

# ================================================================
# POWER / POE TELEMETRY
#
# Only reports explicit platform telemetry when it is exposed.
# No inference is made from link state, speed, or interface state.
# ================================================================

report_power_poe() {

    section "POWER / POE HEALTH"

    FOUND=0

    # Common sysfs locations used by platforms that expose power data.
    for D in /sys/class/power_supply/*; do
        [ -e "$D" ] || continue
        FOUND=1

        NAME="${D##*/}"
        TYPE="$(cat "$D/type" 2>/dev/null)"
        ONLINE="$(cat "$D/online" 2>/dev/null)"
        STATUS="$(cat "$D/status" 2>/dev/null)"

        [ -n "$TYPE" ] || TYPE="N/A"
        [ -n "$ONLINE" ] || ONLINE="N/A"
        [ -n "$STATUS" ] || STATUS="N/A"

        printf '  %-18s Type=%-10s Online=%-5s Status=%s\n' \
            "$NAME" "$TYPE" "$ONLINE" "$STATUS"
    done

    # Look only in likely interface/device paths for explicit
    # PoE/PSE telemetry. Do not recursively scan all of /sys because
    # unrelated filenames may match the same letter sequence.
    POE_FOUND=""

    for F in \
        /sys/class/net/*/device/*poe* \
        /sys/class/net/*/device/*pse* \
        /sys/class/poe/* \
        /sys/class/pse/*
    do
        [ -f "$F" ] || continue
        POE_FOUND="${POE_FOUND}${F}\n"
    done

    if [ -n "$POE_FOUND" ]; then
        FOUND=1

        printf '  Explicit PoE/PSE telemetry files detected:\n'
        printf '%b' "$POE_FOUND" |
        while IFS= read -r FILE; do
            [ -n "$FILE" ] || continue
            VALUE="$(cat "$FILE" 2>/dev/null)"
            printf '    %-60s %s\n' "${FILE#/sys/}" "$VALUE"
        done
    fi

    if [ "$FOUND" -eq 0 ]; then
        skip "PoE/power telemetry not exposed by this platform"
    fi
}

